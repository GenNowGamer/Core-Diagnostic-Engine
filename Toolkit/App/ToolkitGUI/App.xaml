<Application x:Class="ToolkitGUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ToolkitGUI.Models">
    <Application.Resources>
        <ResourceDictionary xmlns:system="clr-namespace:System;assembly=mscorlib">
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <models:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

            <!-- ═══ Color Palette — Professional Dark Theme (Default) ═══ -->

            <!-- Backgrounds -->
            <Color x:Key="BackgroundDark">#11161E</Color>
            <Color x:Key="BackgroundMid">#1A222D</Color>
            <Color x:Key="BackgroundLight">#242E3D</Color>

            <!-- Sidebar (deep navy) -->
            <Color x:Key="SidebarBg">#1B3A5C</Color>
            <Color x:Key="SidebarHover">#15304E</Color>
            <Color x:Key="SidebarActive">#0F2641</Color>
            <Color x:Key="SidebarActiveBar">#3B9EDF</Color>
            <Color x:Key="SidebarText">#A8C4E0</Color>
            <Color x:Key="SidebarTextActive">#FFFFFF</Color>

            <!-- Accents -->
            <Color x:Key="AccentBlue">#3898EC</Color>
            <Color x:Key="AccentGreen">#2EA043</Color>
            <Color x:Key="AccentRed">#E5534B</Color>
            <Color x:Key="AccentYellow">#D29922</Color>

            <!-- Text -->
            <Color x:Key="TextPrimary">#E6EDF5</Color>
            <Color x:Key="TextSecondary">#9FB0C4</Color>
            <Color x:Key="Border">#313E50</Color>

            <!-- Terminal log area -->
            <Color x:Key="LogBg">#0D1821</Color>
            <Color x:Key="LogText">#C8D8E4</Color>

            <!-- Brushes -->
            <SolidColorBrush x:Key="BackgroundDarkBrush"      Color="{StaticResource BackgroundDark}"/>
            <SolidColorBrush x:Key="BackgroundMidBrush"        Color="{StaticResource BackgroundMid}"/>
            <SolidColorBrush x:Key="BackgroundLightBrush"      Color="{StaticResource BackgroundLight}"/>
            <SolidColorBrush x:Key="SidebarBgBrush"           Color="{StaticResource SidebarBg}"/>
            <SolidColorBrush x:Key="SidebarHoverBrush"        Color="{StaticResource SidebarHover}"/>
            <SolidColorBrush x:Key="SidebarActiveBrush"       Color="{StaticResource SidebarActive}"/>
            <SolidColorBrush x:Key="SidebarActiveBarBrush"    Color="{StaticResource SidebarActiveBar}"/>
            <SolidColorBrush x:Key="SidebarTextBrush"         Color="{StaticResource SidebarText}"/>
            <SolidColorBrush x:Key="SidebarTextActiveBrush"   Color="{StaticResource SidebarTextActive}"/>
            <SolidColorBrush x:Key="AccentBlueBrush"          Color="{StaticResource AccentBlue}"/>
            <SolidColorBrush x:Key="AccentGreenBrush"         Color="{StaticResource AccentGreen}"/>
            <SolidColorBrush x:Key="AccentRedBrush"           Color="{StaticResource AccentRed}"/>
            <SolidColorBrush x:Key="AccentYellowBrush"        Color="{StaticResource AccentYellow}"/>
            <SolidColorBrush x:Key="TextPrimaryBrush"         Color="{StaticResource TextPrimary}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush"       Color="{StaticResource TextSecondary}"/>
            <SolidColorBrush x:Key="BorderBrush"              Color="{StaticResource Border}"/>
            <SolidColorBrush x:Key="LogBgBrush"               Color="{StaticResource LogBg}"/>
            <SolidColorBrush x:Key="LogTextBrush"             Color="{StaticResource LogText}"/>
            <SolidColorBrush x:Key="ActionButtonHoverBrush"   Color="#2A82D2"/>
            <SolidColorBrush x:Key="ActionButtonDisabledBgBrush" Color="#2D3746"/>
            <SolidColorBrush x:Key="SurfaceCardAltBrush"      Color="#202936"/>
            <SolidColorBrush x:Key="SurfaceGridRowBrush"      Color="#1A222D"/>
            <SolidColorBrush x:Key="SurfaceGridAltRowBrush"   Color="#202936"/>
            <SolidColorBrush x:Key="SurfaceGridSelectedBrush" Color="#223A58"/>
            <SolidColorBrush x:Key="SurfaceHoverBrush"        Color="#283344"/>
            <SolidColorBrush x:Key="SurfaceWarningBrush"      Color="#3A2B16"/>
            <SolidColorBrush x:Key="SurfaceDangerRowBrush"    Color="#3D1F24"/>
            <SolidColorBrush x:Key="SurfaceSuccessRowBrush"   Color="#172E20"/>
            <SolidColorBrush x:Key="SurfaceInfoBannerBrush"   Color="#1A2E44"/>
            <SolidColorBrush x:Key="SurfaceInfoBannerBorderBrush" Color="#2E5580"/>
            <SolidColorBrush x:Key="SurfaceWarnBannerBrush"   Color="#382A14"/>
            <SolidColorBrush x:Key="SurfaceWarnBannerBorderBrush" Color="#7A5B22"/>
            <SolidColorBrush x:Key="SurfaceHeaderBandBrush"   Color="#243244"/>
            <SolidColorBrush x:Key="SurfaceRunningRowBrush"   Color="#1B334D"/>
            <SolidColorBrush x:Key="LoadingOverlayBrush"      Color="#B30F141C"/>
            <SolidColorBrush x:Key="TextWarningBrush"         Color="#E5B84B"/>
            <SolidColorBrush x:Key="TextWarningDarkBrush"     Color="#F0CB6E"/>
            <SolidColorBrush x:Key="TextDangerBrush"          Color="#F47067"/>
            <SolidColorBrush x:Key="TextSuccessBrush"         Color="#3FB950"/>
            <SolidColorBrush x:Key="TextInfoBrush"            Color="#58A6FF"/>
            <SolidColorBrush x:Key="TextOnNeutralBrush"       Color="#E6EDF5"/>

            <!-- Layout tokens (GridLength for row/column definitions; Double for control metrics) -->
            <GridLength x:Key="NavSidebarWidthFull">220</GridLength>
            <GridLength x:Key="NavSidebarWidthCollapsed">56</GridLength>
            <GridLength x:Key="TitleBarHeight">44</GridLength>
            <GridLength x:Key="InfoBarHeight">60</GridLength>
            <system:Double x:Key="NavItemHeight">42</system:Double>
            <system:Double x:Key="NavItemHeightCompact">36</system:Double>
            <system:Double x:Key="ShellMinWidth">1060</system:Double>
            <system:Double x:Key="ShellMinHeight">640</system:Double>
            <system:Double x:Key="HeaderLabelFontSize">11</system:Double>
            <system:Double x:Key="ScrollBarWidth">12</system:Double>

            <!-- ─── Navigation Button ─── -->
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Height" Value="{StaticResource NavItemHeight}"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="3,0,0,0"
                                    BorderBrush="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource SidebarTextActiveBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource SidebarActiveBrush}"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource SidebarActiveBarBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource SidebarTextActiveBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#3A5E7A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Active Nav Button -->
            <Style x:Key="NavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                <Setter Property="Background" Value="{StaticResource SidebarActiveBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource SidebarTextActiveBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{StaticResource SidebarActiveBrush}"
                                    BorderThickness="3,0,0,0"
                                    BorderBrush="{StaticResource SidebarActiveBarBrush}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Title bar navigation menu trigger -->
            <Style x:Key="NavMenuButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#1E4D80"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#15304E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary Action Button -->
            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentBlueBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="18,9"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource ActionButtonHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource ActionButtonDisabledBgBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Card Style -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BackgroundMidBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="18"/>
            </Style>

            <!-- Default Theme-Aware Control Styles -->
            <Style TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource BackgroundLightBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="{DynamicResource ActionButtonDisabledBgBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="TabControl">
                <Setter Property="Background" Value="{DynamicResource BackgroundMidBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Style>

            <Style TargetType="TabItem">
                <Setter Property="Background" Value="{DynamicResource BackgroundLightBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1,1,1,0"
                                    CornerRadius="4,4,0,0"
                                    Padding="{TemplateBinding Padding}"
                                    Margin="0,0,2,0">
                                <ContentPresenter ContentSource="Header"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource BackgroundMidBrush}"/>
                                    <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True"/>
                                        <Condition Property="IsSelected" Value="False"/>
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="GridViewColumnHeader">
                <Setter Property="Background" Value="{DynamicResource BackgroundLightBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="Padding" Value="8,4"/>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource BackgroundMidBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource AccentBlueBrush}"/>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Background" Value="{DynamicResource BackgroundMidBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton x:Name="ToggleButton"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Bg"
                                                    Background="{DynamicResource BackgroundMidBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="26"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="1"
                                                               Text="▾"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                    <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBlueBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ContentSite"
                                                  IsHitTestVisible="False"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="10,3,28,3"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  TextElement.Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Popup x:Name="Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Grid x:Name="DropDown"
                                          SnapsToDevicePixels="True"
                                          MinWidth="{TemplateBinding ActualWidth}"
                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                        <Border x:Name="DropDownBorder"
                                                Background="{DynamicResource BackgroundMidBrush}"
                                                BorderThickness="1"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                CornerRadius="4"/>
                                        <ScrollViewer Margin="2,4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Grid>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Background" Value="{DynamicResource BackgroundMidBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SurfaceGridSelectedBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Style>

            <Style TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Style>

            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="{DynamicResource SurfaceGridRowBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="RowBackground" Value="{DynamicResource SurfaceGridRowBrush}"/>
                <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfaceGridAltRowBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource BorderBrush}"/>
            </Style>

            <Style TargetType="DataGridCell">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource BackgroundLightBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="10,6"/>
            </Style>

            <Style TargetType="ListView">
                <Setter Property="Background" Value="{DynamicResource SurfaceGridRowBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            </Style>

            <Style TargetType="ListViewItem">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SurfaceGridSelectedBrush}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="TreeView">
                <Setter Property="Background" Value="{DynamicResource SurfaceGridRowBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            </Style>

            <Style TargetType="TreeViewItem">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Style>

            <Style TargetType="ListBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Style>

            <Style TargetType="Expander">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Style>

            <Style TargetType="ContextMenu">
                <Setter Property="Background" Value="{DynamicResource BackgroundMidBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <Style TargetType="MenuItem">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Style>

            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{DynamicResource BackgroundMidBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Style>

            <!-- Read-only TextBox that looks like TextBlock so operators can drag-select/copy -->
            <Style x:Key="SelectableTextStyle" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="IsTabStop" Value="False"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="AcceptsReturn" Value="True"/>
                <Setter Property="Cursor" Value="IBeam"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="CaretBrush" Value="{DynamicResource AccentBlueBrush}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource AccentBlueBrush}"/>
            </Style>
            <Style x:Key="SelectableMonoTextStyle" TargetType="TextBox" BasedOn="{StaticResource SelectableTextStyle}">
                <Setter Property="FontFamily" Value="Consolas, Courier New"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <!-- ScrollBar: Width applies to vertical bars; horizontal bars must clear Width
                 or they collapse to a ~12px square (unusable "tiny button"). -->
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Width" Value="{StaticResource ScrollBarWidth}"/>
                <Setter Property="MinWidth" Value="{StaticResource ScrollBarWidth}"/>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Height" Value="16"/>
                        <Setter Property="MinHeight" Value="16"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Global TextBlock default -->
            <!-- NOTE: Foreground is intentionally NOT set here. -->
            <!-- Setting it globally overrides Button.Foreground inheritance via ContentPresenter, -->
            <!-- making nav and title bar button text invisible. Instead, Foreground is set on -->
            <!-- the content area container (MainWindow) so it inherits correctly per region. -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <DataTemplate x:Key="FormattedResultItemTemplate">
                <Border CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Background="{DynamicResource SurfaceCardAltBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Padding" Value="12"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowCompactStartupRow}" Value="True">
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <!-- Compact verified startup row: name · location | risk band -->
                        <Grid Visibility="{Binding ShowCompactStartupRow, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding CompactStartupSummary, Mode=OneWay}"
                                     Style="{StaticResource SelectableTextStyle}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,12,0"
                                     FontSize="12"/>
                            <Border Grid.Column="1"
                                    Padding="8,3"
                                    CornerRadius="4"
                                    Background="{Binding RiskBandBrush}"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowRiskBand, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding RiskBand}" Foreground="White"
                                           FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <StackPanel Visibility="{Binding ShowCompactStartupRow, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Border Margin="0,0,10,0"
                                        Padding="8,3"
                                        CornerRadius="4"
                                        Background="{Binding StatusLabelBrush}"
                                        VerticalAlignment="Top"
                                        Visibility="{Binding ShowStatusLabel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding StatusLabelText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Border>
                                <TextBox Text="{Binding Name, Mode=OneWay}"
                                         Style="{StaticResource SelectableTextStyle}"
                                         FontWeight="SemiBold"
                                         FontSize="13"/>
                            </StackPanel>

                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding ShowCompactFilePath, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="FILE PATH"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EntryPath, Mode=OneWay}"
                                         Style="{StaticResource SelectableMonoTextStyle}"
                                         FontSize="11"/>
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding IsStructuredHealthFinding, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="IMPACT" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"
                                           Visibility="{Binding ShowImpact, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBox Text="{Binding Impact, Mode=OneWay}"
                                         Style="{StaticResource SelectableTextStyle}"
                                         FontSize="12" Margin="0,0,0,8"
                                         Visibility="{Binding ShowImpact, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,16,0"
                                                Visibility="{Binding ShowSeverity, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="SEVERITY" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <Border Padding="8,3" CornerRadius="4" Background="{Binding SeverityBrush}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Severity}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding ShowConfidence, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="CONFIDENCE" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding ConfidenceDisplay, Mode=OneWay}"
                                                 Style="{StaticResource SelectableTextStyle}"
                                                 FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="EVIDENCE" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"
                                           Visibility="{Binding ShowEvidence, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBox Text="{Binding EvidenceDisplay, Mode=OneWay}"
                                         Style="{StaticResource SelectableTextStyle}"
                                         FontSize="12" Margin="0,0,0,8"
                                         Visibility="{Binding ShowEvidence, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="RECOMMENDATION" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"
                                           Visibility="{Binding ShowRecommendation, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBox Text="{Binding RecommendationDisplay, Mode=OneWay}"
                                         Style="{StaticResource SelectableTextStyle}"
                                         FontSize="12"
                                         Visibility="{Binding ShowRecommendation, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding ShowStartupReviewDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="WHY FLAGGED FOR REVIEW" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <Border Padding="8,4" CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        Background="{Binding SeverityBrush}">
                                    <TextBlock Text="{Binding ReviewReason}" Foreground="White"
                                               FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </Border>
                                <TextBlock Text="STARTUP LOCATION" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,10,0,4"/>
                                <TextBox Text="{Binding StartupLocation, Mode=OneWay}"
                                         Style="{StaticResource SelectableTextStyle}"
                                         FontSize="12"/>
                                <TextBlock Text="TARGET PATH" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,10,0,4"
                                           Visibility="{Binding ShowStartupTargetPath, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBox Text="{Binding EntryPath, Mode=OneWay}"
                                         Style="{StaticResource SelectableMonoTextStyle}"
                                         FontSize="11"
                                         Visibility="{Binding ShowStartupTargetPath, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="RISK BAND" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,10,0,4"
                                           Visibility="{Binding ShowRiskBand, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <Border Padding="8,4" CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        Background="{Binding RiskBandBrush}"
                                        Visibility="{Binding ShowRiskBand, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding RiskBand}" Foreground="White"
                                               FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding ShowRichEntry, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowStartupReviewDetails}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="LOCATION" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"
                                           Visibility="{Binding ShowEntryLocation, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBox Text="{Binding EntryLocation, Mode=OneWay}"
                                         Style="{StaticResource SelectableTextStyle}"
                                         FontSize="12" Margin="0,0,0,8"
                                         Visibility="{Binding ShowEntryLocation, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="TARGET PATH" FontSize="10" FontWeight="Bold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"
                                           Visibility="{Binding ShowEntryPath, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBox Text="{Binding EntryPath, Mode=OneWay}"
                                         Style="{StaticResource SelectableMonoTextStyle}"
                                         FontSize="11" Margin="0,0,0,8"
                                         Visibility="{Binding ShowEntryPath, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBox Text="{Binding DetailNotes, Mode=OneWay}"
                                         Style="{StaticResource SelectableTextStyle}"
                                         FontSize="12"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         Visibility="{Binding ShowDetailNotes, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowStartupReviewDetails}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ShowRichEntry}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Margin="0,0,8,0" Padding="6,2" CornerRadius="3"
                                        Background="{Binding SeverityBrush}"
                                        Visibility="{Binding ShowSeverity, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Severity}" Foreground="White"
                                               FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                                <TextBox Text="{Binding Classification, Mode=OneWay}"
                                         Style="{StaticResource SelectableTextStyle}"
                                         FontSize="12"
                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding ShowClassification, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>

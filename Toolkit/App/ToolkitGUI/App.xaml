<Application x:Class="ToolkitGUI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:ToolkitGUI.Models">
    <Application.Resources>
        <ResourceDictionary xmlns:system="clr-namespace:System;assembly=mscorlib">
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <models:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>

            <!-- ═══ Color Palette — Professional Light Theme ═══ -->

            <!-- Backgrounds -->
            <Color x:Key="BackgroundDark">#EEF2F7</Color>
            <Color x:Key="BackgroundMid">#FFFFFF</Color>
            <Color x:Key="BackgroundLight">#E2E8F2</Color>

            <!-- Sidebar (deep navy) -->
            <Color x:Key="SidebarBg">#1B3A5C</Color>
            <Color x:Key="SidebarHover">#15304E</Color>
            <Color x:Key="SidebarActive">#0F2641</Color>
            <Color x:Key="SidebarActiveBar">#3B9EDF</Color>
            <Color x:Key="SidebarText">#A8C4E0</Color>
            <Color x:Key="SidebarTextActive">#FFFFFF</Color>

            <!-- Accents -->
            <Color x:Key="AccentBlue">#0078D4</Color>
            <Color x:Key="AccentGreen">#0D7A3E</Color>
            <Color x:Key="AccentRed">#C42B1C</Color>
            <Color x:Key="AccentYellow">#926800</Color>

            <!-- Text -->
            <Color x:Key="TextPrimary">#1A2840</Color>
            <Color x:Key="TextSecondary">#5A6B80</Color>
            <Color x:Key="Border">#D0D6E0</Color>

            <!-- Terminal log area -->
            <Color x:Key="LogBg">#0D1821</Color>
            <Color x:Key="LogText">#C8D8E4</Color>

            <!-- Brushes -->
            <SolidColorBrush x:Key="BackgroundDarkBrush"      Color="{StaticResource BackgroundDark}"/>
            <SolidColorBrush x:Key="BackgroundMidBrush"        Color="{StaticResource BackgroundMid}"/>
            <SolidColorBrush x:Key="BackgroundLightBrush"      Color="{StaticResource BackgroundLight}"/>
            <SolidColorBrush x:Key="SidebarBgBrush"           Color="{StaticResource SidebarBg}"/>
            <SolidColorBrush x:Key="SidebarHoverBrush"        Color="{StaticResource SidebarHover}"/>
            <SolidColorBrush x:Key="SidebarActiveBrush"       Color="{StaticResource SidebarActive}"/>
            <SolidColorBrush x:Key="SidebarActiveBarBrush"    Color="{StaticResource SidebarActiveBar}"/>
            <SolidColorBrush x:Key="SidebarTextBrush"         Color="{StaticResource SidebarText}"/>
            <SolidColorBrush x:Key="SidebarTextActiveBrush"   Color="{StaticResource SidebarTextActive}"/>
            <SolidColorBrush x:Key="AccentBlueBrush"          Color="{StaticResource AccentBlue}"/>
            <SolidColorBrush x:Key="AccentGreenBrush"         Color="{StaticResource AccentGreen}"/>
            <SolidColorBrush x:Key="AccentRedBrush"           Color="{StaticResource AccentRed}"/>
            <SolidColorBrush x:Key="AccentYellowBrush"        Color="{StaticResource AccentYellow}"/>
            <SolidColorBrush x:Key="TextPrimaryBrush"         Color="{StaticResource TextPrimary}"/>
            <SolidColorBrush x:Key="TextSecondaryBrush"       Color="{StaticResource TextSecondary}"/>
            <SolidColorBrush x:Key="BorderBrush"              Color="{StaticResource Border}"/>
            <SolidColorBrush x:Key="LogBgBrush"               Color="{StaticResource LogBg}"/>
            <SolidColorBrush x:Key="LogTextBrush"             Color="{StaticResource LogText}"/>

            <!-- Layout tokens (GridLength for row/column definitions; Double for control metrics) -->
            <GridLength x:Key="NavSidebarWidthFull">220</GridLength>
            <GridLength x:Key="NavSidebarWidthCollapsed">56</GridLength>
            <GridLength x:Key="TitleBarHeight">44</GridLength>
            <GridLength x:Key="InfoBarHeight">60</GridLength>
            <system:Double x:Key="NavItemHeight">42</system:Double>
            <system:Double x:Key="NavItemHeightCompact">36</system:Double>
            <system:Double x:Key="ShellMinWidth">1060</system:Double>
            <system:Double x:Key="ShellMinHeight">640</system:Double>
            <system:Double x:Key="HeaderLabelFontSize">11</system:Double>
            <system:Double x:Key="ScrollBarWidth">12</system:Double>

            <!-- ─── Navigation Button ─── -->
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource SidebarTextBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="16,0"/>
                <Setter Property="Height" Value="{StaticResource NavItemHeight}"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="3,0,0,0"
                                    BorderBrush="Transparent"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource SidebarHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource SidebarTextActiveBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="{StaticResource SidebarActiveBrush}"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource SidebarActiveBarBrush}"/>
                                    <Setter Property="Foreground" Value="{StaticResource SidebarTextActiveBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Foreground" Value="#3A5E7A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Active Nav Button -->
            <Style x:Key="NavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
                <Setter Property="Background" Value="{StaticResource SidebarActiveBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource SidebarTextActiveBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{StaticResource SidebarActiveBrush}"
                                    BorderThickness="3,0,0,0"
                                    BorderBrush="{StaticResource SidebarActiveBarBrush}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Title bar navigation menu trigger -->
            <Style x:Key="NavMenuButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#1E4D80"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#15304E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary Action Button -->
            <Style x:Key="ActionButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBlueBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="18,9"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="5"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#005FA3"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Background" Value="#C8D0DC"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Card Style -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource BackgroundMidBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="6"/>
                <Setter Property="Padding" Value="18"/>
            </Style>

            <!-- ScrollBar: Width applies to vertical bars; horizontal bars must clear Width
                 or they collapse to a ~12px square (unusable "tiny button"). -->
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Width" Value="{StaticResource ScrollBarWidth}"/>
                <Setter Property="MinWidth" Value="{StaticResource ScrollBarWidth}"/>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Height" Value="16"/>
                        <Setter Property="MinHeight" Value="16"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- Global TextBlock default -->
            <!-- NOTE: Foreground is intentionally NOT set here. -->
            <!-- Setting it globally overrides Button.Foreground inheritance via ContentPresenter, -->
            <!-- making nav and title bar button text invisible. Instead, Foreground is set on -->
            <!-- the content area container (MainWindow) so it inherits correctly per region. -->
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <DataTemplate x:Key="FormattedResultItemTemplate">
                <Border CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{StaticResource BorderBrush}"
                        Background="#FAFBFD">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Padding" Value="12"/>
                            <Setter Property="Margin" Value="0,0,0,10"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowCompactStartupRow}" Value="True">
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <!-- Compact verified startup row: name · location | risk band -->
                        <Grid Visibility="{Binding ShowCompactStartupRow, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding CompactStartupSummary}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0"
                                       FontSize="12"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Border Grid.Column="1"
                                    Padding="8,3"
                                    CornerRadius="4"
                                    Background="{Binding RiskBandBrush}"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowRiskBand, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding RiskBand}" Foreground="White"
                                           FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>

                        <StackPanel Visibility="{Binding ShowCompactStartupRow, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Border Margin="0,0,10,0"
                                        Padding="8,3"
                                        CornerRadius="4"
                                        Background="{Binding StatusLabelBrush}"
                                        VerticalAlignment="Top"
                                        Visibility="{Binding ShowStatusLabel, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding StatusLabelText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                </Border>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <StackPanel Margin="0,8,0,0"
                                        Visibility="{Binding ShowCompactFilePath, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="FILE PATH"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding EntryPath}"
                                           FontSize="11"
                                           FontFamily="Consolas, Courier New"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding IsStructuredHealthFinding, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="IMPACT" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"
                                           Visibility="{Binding ShowImpact, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding Impact}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Visibility="{Binding ShowImpact, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <StackPanel Margin="0,0,16,0"
                                                Visibility="{Binding ShowSeverity, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="SEVERITY" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <Border Padding="8,3" CornerRadius="4" Background="{Binding SeverityBrush}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Severity}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Visibility="{Binding ShowConfidence, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="CONFIDENCE" FontSize="10" FontWeight="Bold"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding ConfidenceDisplay}" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Text="EVIDENCE" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"
                                           Visibility="{Binding ShowEvidence, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding EvidenceDisplay}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Visibility="{Binding ShowEvidence, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="RECOMMENDATION" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"
                                           Visibility="{Binding ShowRecommendation, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding RecommendationDisplay}" FontSize="12" TextWrapping="Wrap"
                                           Visibility="{Binding ShowRecommendation, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding ShowStartupReviewDetails, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="WHY FLAGGED FOR REVIEW" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <Border Padding="8,4" CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        Background="{Binding SeverityBrush}">
                                    <TextBlock Text="{Binding ReviewReason}" Foreground="White"
                                               FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                </Border>
                                <TextBlock Text="STARTUP LOCATION" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,10,0,4"/>
                                <TextBlock Text="{Binding StartupLocation}" FontSize="12"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="TARGET PATH" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,10,0,4"
                                           Visibility="{Binding ShowStartupTargetPath, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding EntryPath}" FontSize="11"
                                           FontFamily="Consolas, Courier New"
                                           TextWrapping="Wrap"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Visibility="{Binding ShowStartupTargetPath, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="RISK BAND" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,10,0,4"
                                           Visibility="{Binding ShowRiskBand, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <Border Padding="8,4" CornerRadius="4"
                                        HorizontalAlignment="Left"
                                        Background="{Binding RiskBandBrush}"
                                        Visibility="{Binding ShowRiskBand, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding RiskBand}" Foreground="White"
                                               FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>

                            <StackPanel Margin="0,10,0,0"
                                        Visibility="{Binding ShowRichEntry, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowStartupReviewDetails}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="LOCATION" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"
                                           Visibility="{Binding ShowEntryLocation, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding EntryLocation}" FontSize="12" TextWrapping="Wrap"
                                           Margin="0,0,0,8"
                                           Visibility="{Binding ShowEntryLocation, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="TARGET PATH" FontSize="10" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"
                                           Visibility="{Binding ShowEntryPath, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding EntryPath}" FontSize="11" FontFamily="Consolas, Courier New"
                                           TextWrapping="Wrap" Margin="0,0,0,8"
                                           Visibility="{Binding ShowEntryPath, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                <TextBlock Text="{Binding DetailNotes}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Visibility="{Binding ShowDetailNotes, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ShowStartupReviewDetails}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding ShowRichEntry}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Margin="0,0,8,0" Padding="6,2" CornerRadius="3"
                                        Background="{Binding SeverityBrush}"
                                        Visibility="{Binding ShowSeverity, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Severity}" Foreground="White"
                                               FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="{Binding Classification}" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                           Visibility="{Binding ShowClassification, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>

        </ResourceDictionary>
    </Application.Resources>
</Application>

<Window x:Class="ToolkitGUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ToolkitGUI.Views"
        xmlns:vm="clr-namespace:ToolkitGUI.ViewModels"
        Title="Core Diagnostic Engine"
        Height="820" Width="1340"
        MinHeight="{StaticResource ShellMinHeight}" MinWidth="{StaticResource ShellMinWidth}"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip">

    <!-- DataContext is assigned in code-behind after Show() so WinPE can present the shell
         before DashboardView / work-order init runs. -->

    <Border Background="{StaticResource BackgroundDarkBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            UseLayoutRounding="True"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ TITLE BAR (navy) ═══ -->
            <Border Grid.Row="0"
                    Background="{StaticResource SidebarBgBrush}"
                    CornerRadius="8,8,0,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="BtnNavMenu" Grid.Column="0"
                            Style="{StaticResource NavMenuButtonStyle}"
                            ToolTip="Open CDE tools menu"
                            Click="NavMenu_Click"
                            Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="/ToolkitGUI;component/Assets/appicon_1024.png"
                                   Width="18"
                                   Height="18"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                            <TextBlock Text="Tools" FontSize="13" FontWeight="SemiBold"
                                       Foreground="White" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                            CornerRadius="4" Padding="12,4" Background="#1E4D80">
                        <TextBlock Text="{Binding EnvironmentMode}"
                                   FontSize="11" FontWeight="Bold" Foreground="#7EC8F5"/>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button Content="─" Width="40" Height="36" Background="Transparent" BorderThickness="0"
                                Foreground="White" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="MinimizeButton_Click"
                                ToolTip="Minimize"/>
                        <Button Content="□" Width="40" Height="36" Background="Transparent" BorderThickness="0"
                                Foreground="White" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="MaximizeButton_Click"
                                ToolTip="Restore"/>
                        <Button Content="✕" Width="40" Height="36" Background="Transparent" BorderThickness="0"
                                Foreground="White" FontSize="14" FontWeight="Bold" Cursor="Hand" Click="CloseButton_Click"
                                ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ HEADER INFO BAR (white) ═══ -->
            <Border Grid.Row="1"
                    Background="{StaticResource BackgroundMidBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <ScrollViewer Margin="24,0"
                              VerticalScrollBarVisibility="Disabled"
                              HorizontalScrollBarVisibility="Auto"
                              Focusable="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                        <StackPanel>
                            <TextBlock Text="MACHINE" FontSize="{StaticResource HeaderLabelFontSize}" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding MachineName}" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>

                        <Rectangle Width="1" Height="30" Fill="{StaticResource BorderBrush}" Margin="20,0"/>

                        <StackPanel>
                            <TextBlock Text="OS" FontSize="{StaticResource HeaderLabelFontSize}" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding OsVersion}" FontSize="13"/>
                        </StackPanel>

                        <Rectangle Width="1" Height="30" Fill="{StaticResource BorderBrush}" Margin="20,0"/>

                        <StackPanel>
                            <TextBlock Text="CPU" FontSize="{StaticResource HeaderLabelFontSize}" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding CpuUsage, StringFormat={}{0:F0}%}" FontSize="13" Margin="0,0,8,0"/>
                                <ProgressBar Value="{Binding CpuUsage}" Maximum="100" Width="70" Height="7"
                                             VerticalAlignment="Center"
                                             Background="{StaticResource BackgroundLightBrush}"
                                             Foreground="{StaticResource AccentBlueBrush}"
                                             BorderThickness="0"/>
                            </StackPanel>
                        </StackPanel>

                        <Rectangle Width="1" Height="30" Fill="{StaticResource BorderBrush}" Margin="20,0"/>

                        <StackPanel>
                            <TextBlock Text="RAM" FontSize="{StaticResource HeaderLabelFontSize}" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding RamUsage, StringFormat={}{0:F0}%}" FontSize="13" Margin="0,0,8,0"/>
                                <ProgressBar Value="{Binding RamUsage}" Maximum="100" Width="70" Height="7"
                                             VerticalAlignment="Center"
                                             Background="{StaticResource BackgroundLightBrush}"
                                             Foreground="{StaticResource AccentGreenBrush}"
                                             BorderThickness="0"/>
                            </StackPanel>
                        </StackPanel>

                        <Rectangle Width="1" Height="30" Fill="{StaticResource BorderBrush}" Margin="20,0"/>

                        <StackPanel>
                            <TextBlock Text="SMART" FontSize="{StaticResource HeaderLabelFontSize}" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding SmartSummary}" FontSize="13"
                                       Foreground="{Binding SmartStatusBrush}"/>
                        </StackPanel>

                        <Rectangle Width="1" Height="30" Fill="{StaticResource BorderBrush}" Margin="20,0"/>

                        <StackPanel>
                            <TextBlock Text="UPTIME" FontSize="{StaticResource HeaderLabelFontSize}" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Uptime}" FontSize="13"/>
                        </StackPanel>

                        <Rectangle Width="1" Height="30" Fill="{StaticResource BorderBrush}" Margin="20,0"
                                   Visibility="{Binding HasActiveWorkOrder, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <StackPanel Visibility="{Binding HasActiveWorkOrder, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="WORK ORDER" FontSize="{StaticResource HeaderLabelFontSize}" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ActiveCaseId}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBlueBrush}"/>
                            <TextBlock Text="{Binding ActiveWorkOrderDetail}" FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ═══ MAIN CONTENT (full width) ═══ -->
            <Grid Grid.Row="2" Background="{StaticResource BackgroundDarkBrush}"
                  TextElement.Foreground="{StaticResource TextPrimaryBrush}">
                <ContentControl x:Name="MainContent"
                                Content="{Binding CurrentView}"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Margin="0"/>
            </Grid>

            <!-- ═══ NAV FLYOUT (Start-menu style) ═══ -->
            <Popup x:Name="NavFlyoutPopup"
                   PlacementTarget="{Binding ElementName=BtnNavMenu}"
                   Placement="Bottom"
                   HorizontalOffset="0"
                   VerticalOffset="4"
                   StaysOpen="False"
                   AllowsTransparency="False"
                   PopupAnimation="None">
                <Border x:Name="NavFlyoutBorder"
                        Width="280"
                        MaxHeight="560"
                        Background="{StaticResource SidebarBgBrush}"
                        BorderBrush="#122840"
                        BorderThickness="1"
                        CornerRadius="0,0,8,8"
                        Padding="0,4,0,8">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock x:Name="NavHeaderMain" Text="MAIN" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource SidebarTextBrush}"
                                       Margin="16,12,0,6"/>

                            <Button x:Name="BtnDashboard" Content="📊  Dashboard"
                                    Style="{StaticResource NavButtonActiveStyle}"
                                    Click="Nav_Click" Tag="Dashboard"/>
                            <Button x:Name="BtnSystemHealth" Content="🏥  System Health Check"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="Nav_Click" Tag="SystemHealth"/>
                            <Button x:Name="BtnSmartAnalyzer" Content="💿  S.M.A.R.T. Analyzer"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="Nav_Click" Tag="SmartAnalyzer"/>
                            <Button x:Name="BtnHwDiag" Content="🖥  Diag &amp; Repair"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="Nav_Click" Tag="DiagAndRepair"/>
                            <Button x:Name="BtnChuResults" Content="💾  CHU Pre-Boot Results"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="Nav_Click" Tag="ChuResults"/>

                            <TextBlock x:Name="NavHeaderRepair" Text="REPAIR" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource SidebarTextBrush}"
                                       Margin="16,14,0,6"/>

                            <Button x:Name="BtnOSRepair" Content="🔧  OS Repair"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="Nav_Click" Tag="OSRepair"/>
                            <Button x:Name="BtnMalware" Content="🛡  Malware Cleanup"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="Nav_Click" Tag="MalwareCleanup"/>
                            <Button x:Name="BtnHijackRepair" Content="🔒  Hijack &amp; Scam Repair"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="Nav_Click" Tag="HijackRepair"/>
                            <Button x:Name="BtnBootloaderRepair" Content="💽  Disk &amp; Boot Repair"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="Nav_Click" Tag="BootloaderRepair"/>

                            <TextBlock x:Name="NavHeaderMaintenance" Text="MAINTENANCE" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource SidebarTextBrush}"
                                       Margin="16,14,0,6"/>

                            <Button x:Name="BtnBackup" Content="💾  Backup &amp; Imaging"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="Nav_Click" Tag="BackupAndImaging"/>
                            <Button x:Name="BtnPostOp" Content="✅  Post-Op Cleanup"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="Nav_Click" Tag="PostOp"/>

                            <TextBlock x:Name="NavHeaderUtilities" Text="UTILITIES" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource SidebarTextBrush}"
                                       Margin="16,14,0,6"/>

                            <Button x:Name="BtnTools" Content="🛠  Tools Library"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="Nav_Click" Tag="ToolsLibrary"/>
                            <Button x:Name="BtnFileManager" Content="📁  File Manager"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="Nav_Click" Tag="FileManager"/>
                            <Button x:Name="BtnStartupMgr" Content="🚀  Startup Manager"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="Nav_Click" Tag="StartupManager"/>
                            <Button x:Name="BtnProcessAnalyzer" Content="⚙  Process Analyzer"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="Nav_Click" Tag="ProcessAnalyzer"/>
                            <Button x:Name="BtnTempCleaner" Content="🧹  Temp File Cleaner"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="Nav_Click" Tag="TempFileCleaner"/>
                            <Button x:Name="BtnUninstallMgr" Content="📦  Uninstall Manager"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="Nav_Click" Tag="UninstallManager"/>
                            <Button x:Name="BtnFastFixes" Content="⚡  Fast Fixes"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="Nav_Click" Tag="FastFixes"/>
                            <Button x:Name="BtnSettings" Content="⚙  Settings"
                                    Style="{StaticResource NavButtonStyle}"
                                    Click="Nav_Click" Tag="Settings"/>

                            <TextBlock x:Name="NavVersionLabel" Text="v1.0.0" FontSize="10"
                                       Foreground="#2E5A80"
                                       HorizontalAlignment="Center" Margin="0,20,0,8"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Popup>
        </Grid>
    </Border>
</Window>

<Window x:Class="ToolkitGUI.Views.ProcessAnalyzerCstResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CST Scan Results"
        Height="720"
        Width="1080"
        MinHeight="620"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundDarkBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="CST Custom Scan"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="ProcessNameText"
                               Margin="0,6,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TargetPathText"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="VerdictDetailText"
                               Margin="0,10,0,0"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border x:Name="VerdictBadge"
                        Grid.Column="1"
                        Padding="14,8"
                        CornerRadius="16"
                        VerticalAlignment="Top"
                        Background="{StaticResource AccentBlueBrush}">
                    <TextBlock x:Name="VerdictText"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="13"/>
                </Border>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="1"
                     Margin="0,14,0,0"
                     Columns="4">
            <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="FILES ANALYZED" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="ItemsScannedText" Style="{StaticResource MetricValueStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="THREATS" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="ThreatsText" Style="{StaticResource MetricValueStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="WARNINGS" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="WarningsText" Style="{StaticResource MetricValueStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="SCAN ERRORS" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="ScanErrorsText" Style="{StaticResource MetricValueStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Style="{StaticResource CardStyle}"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="180"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource BackgroundLightBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="Findings"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Review severity, detector, and evidence for the scanned executable."
                                   Margin="0,4,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <DataGrid Grid.Row="1"
                          x:Name="FindingsGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          Margin="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                        <DataGridTextColumn Header="Detector" Binding="{Binding Detector}" Width="150"/>
                        <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceDisplay}" Width="90"/>
                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="240"/>
                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="2"
                        x:Name="SuppressedHeader"
                        Visibility="Collapsed"
                        Background="{StaticResource BackgroundLightBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,1"
                        Padding="16,10">
                    <TextBlock Text="Suppressed audit findings (outside strict scope, shown for review)"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>

                <DataGrid Grid.Row="3"
                          x:Name="SuppressedGrid"
                          Visibility="Collapsed"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          Margin="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180"/>
                        <DataGridTextColumn Header="Detector" Binding="{Binding Detector}" Width="150"/>
                        <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceDisplay}" Width="90"/>
                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="240"/>
                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="ActionSummaryText"
                       Visibility="Collapsed"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="CoverageReasonText"
                       Visibility="Collapsed"
                       Margin="0,6,0,0"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>
            <ItemsControl x:Name="ErrorDetailsList"
                          Visibility="Collapsed"
                          Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontSize="12"
                                   Foreground="#B45309"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Use Malware Cleanup for full-system scans and remediation actions."/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Copy summary"
                        MinWidth="120"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CopySummaryButton_Click"/>
                <Button Content="Malware Cleanup"
                        MinWidth="140"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="MalwareCleanupButton_Click"/>
                <Button Content="OK"
                        MinWidth="90"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="OkButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

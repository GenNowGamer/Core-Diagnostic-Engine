<Window x:Class="ToolkitGUI.Views.ProcessAnalyzerCstResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CST Scan"
        Height="820"
        Width="1080"
        MinHeight="700"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundDarkBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <!-- Persistent H-scroll: clear app Width=12 on horizontal bars inside this dialog -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="16"/>
                    <Setter Property="MinHeight" Value="16"/>
                    <Setter Property="MaxHeight" Value="18"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- Findings + suppressed share remaining height (2:1) so both stay usable -->
            <RowDefinition x:Name="FindingsSectionRow" Height="2*" MinHeight="220"/>
            <RowDefinition x:Name="SuppressedSectionRow" Height="0" MinHeight="0"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TitleText"
                               Text="CST Scan"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="ScanKindSubtitle"
                               Text="CustomScan"
                               Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="ProcessNameText"
                               Margin="0,6,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TargetPathText"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="VerdictDetailText"
                               Margin="0,10,0,0"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               MaxHeight="52"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Border x:Name="VerdictBadge"
                        Grid.Column="1"
                        Padding="14,8"
                        CornerRadius="16"
                        VerticalAlignment="Top"
                        Background="{StaticResource AccentBlueBrush}">
                    <TextBlock x:Name="VerdictText"
                               Text="Scanning..."
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="13"/>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="ProgressPanel"
                Grid.Row="1"
                Margin="0,14,0,0"
                Style="{StaticResource CardStyle}"
                Padding="20"
                Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProgressPhaseText"
                               Text="Preparing scan..."
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="ProgressPercentText"
                               Grid.Column="1"
                               Text="0%"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Top"/>
                </Grid>
                <ProgressBar x:Name="ScanProgressBar"
                             Height="14"
                             Margin="0,12,0,0"
                             Minimum="0"
                             Maximum="100"
                             Value="0"/>
                <TextBlock x:Name="ProgressDetailText"
                           Margin="0,10,0,0"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="Starting Core Security Tool..."/>
                <TextBlock x:Name="ProgressPathText"
                           Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <UniformGrid x:Name="MetricsPanel"
                     Grid.Row="1"
                     Margin="0,14,0,0"
                     Columns="4"
                     Visibility="Collapsed">
            <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="FILES ANALYZED" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="ItemsScannedText" Style="{StaticResource MetricValueStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="THREATS" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="ThreatsText" Style="{StaticResource MetricValueStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="WARNINGS" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="WarningsText" Style="{StaticResource MetricValueStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="SCAN ERRORS" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="ScanErrorsText" Style="{StaticResource MetricValueStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <UniformGrid x:Name="StartupAxisPanel"
                     Grid.Row="1"
                     Margin="0,14,0,0"
                     Columns="3"
                     Visibility="Collapsed">
            <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="FILE" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="FileVerdictText" Style="{StaticResource MetricValueStyle}" FontSize="18" Margin="0,4,0,0"/>
                    <TextBlock x:Name="FileVerdictDetailText" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="COMMAND LINE" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="CommandLineVerdictText" Style="{StaticResource MetricValueStyle}" FontSize="18" Margin="0,4,0,0"/>
                    <TextBlock x:Name="CommandLineVerdictDetailText" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="PERSISTENCE" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="PersistenceVerdictText" Style="{StaticResource MetricValueStyle}" FontSize="18" Margin="0,4,0,0"/>
                    <TextBlock x:Name="PersistenceVerdictDetailText" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border x:Name="FindingsPanel"
                Grid.Row="2"
                Margin="0,14,0,0"
                Style="{StaticResource CardStyle}"
                Padding="0"
                Visibility="Collapsed"
                ClipToBounds="True">
            <Grid x:Name="FindingsContentGrid" ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="80"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource BackgroundLightBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="FindingsHeaderText"
                                       Text="Findings"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="FindingsSubtitleText"
                                       Text="Select actionable file traces to quarantine or remove."
                                       Margin="0,2,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock x:Name="SelectionSummaryText"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Selected: 0"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        x:Name="RemediationToolbar"
                        Background="{StaticResource BackgroundLightBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,10"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Select Actionable"
                                MinWidth="140"
                                Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="SelectActionableButton_Click"/>
                        <Button Content="Clear Selection"
                                MinWidth="120"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ClearSelectionButton_Click"/>
                    </StackPanel>
                </Border>

                <!-- Clip + MaxWidth constraint (code-behind) keeps H-scrollbar in the visible viewport -->
                <Border Grid.Row="2"
                        x:Name="FindingsGridHost"
                        Margin="0,0,0,2"
                        ClipToBounds="True"
                        Background="Transparent"
                        SizeChanged="FindingsGridHost_SizeChanged">
                    <DataGrid x:Name="FindingsGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserResizeColumns="True"
                              CanUserSortColumns="True"
                              IsReadOnly="False"
                              SelectionMode="Extended"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Stretch"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Visible"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="False"
                              Loaded="FindingsGrid_Loaded"
                              SizeChanged="FindingsGrid_SizeChanged"
                              CellEditEnding="FindingsGrid_CellEditEnding">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="Pick"
                                                    Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Width="55" MinWidth="55"/>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" MinWidth="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100" MinWidth="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" MinWidth="160" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Detector" Binding="{Binding Detector}" Width="140" MinWidth="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Warning" Binding="{Binding WarningBadge}" Width="150" MinWidth="150" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceDisplay}" Width="90" MinWidth="90" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="480" MinWidth="320" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="480" MinWidth="320" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Note" Binding="{Binding SelectionNote}" Width="220" MinWidth="160" IsReadOnly="True"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="SuppressedPanel"
                Grid.Row="3"
                Margin="0,10,0,0"
                Style="{StaticResource CardStyle}"
                Padding="0"
                Visibility="Collapsed"
                ClipToBounds="True">
            <Grid ClipToBounds="True">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="100"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0"
                        x:Name="SuppressedHeader"
                        Background="{StaticResource BackgroundLightBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,10">
                    <TextBlock Text="Suppressed audit findings (outside strict scope, shown for review)"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>
                <Border Grid.Row="1"
                        x:Name="SuppressedGridHost"
                        Margin="0,0,0,2"
                        ClipToBounds="True"
                        Background="Transparent"
                        SizeChanged="SuppressedGridHost_SizeChanged">
                    <DataGrid x:Name="SuppressedGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserResizeColumns="True"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              RowHeaderWidth="0"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Stretch"
                              EnableRowVirtualization="True"
                              EnableColumnVirtualization="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Visible"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              ScrollViewer.CanContentScroll="False"
                              Loaded="SuppressedGrid_Loaded"
                              SizeChanged="SuppressedGrid_SizeChanged">
                        <DataGrid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                <Setter Property="TextWrapping" Value="NoWrap"/>
                                <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" MinWidth="90"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100" MinWidth="100"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" MinWidth="160"/>
                            <DataGridTextColumn Header="Detector" Binding="{Binding Detector}" Width="140" MinWidth="140"/>
                            <DataGridTextColumn Header="Warning" Binding="{Binding WarningBadge}" Width="150" MinWidth="150"/>
                            <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceDisplay}" Width="90" MinWidth="90"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="480" MinWidth="320"/>
                            <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="480" MinWidth="320"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="ScanningPlaceholderPanel"
                Grid.Row="2"
                Margin="0,14,0,0"
                Style="{StaticResource CardStyle}"
                Padding="24"
                Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Scan in progress"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="Pre-scan checks (targets, known-good baselines, path discovery) and file analysis both report above. This panel is replaced when the scan finishes."/>
            </StackPanel>
        </Border>

        <!-- Scan/coverage narrative stays out of the UI (Copy summary / PDF only). Errors still surface here. -->
        <ItemsControl x:Name="ErrorDetailsList"
                      Grid.Row="4"
                      Visibility="Collapsed"
                      Margin="0,10,0,0"
                      MaxHeight="72">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               FontSize="12"
                               Foreground="#B45309"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CopySummaryButton"
                        Content="Copy summary"
                        MinWidth="120"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CopySummaryButton_Click"
                        IsEnabled="False"/>
                <Button x:Name="OpenReportButton"
                        Content="Open Report"
                        MinWidth="120"
                        Margin="0,0,10,0"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="OpenReportButton_Click"
                        IsEnabled="False"/>
                <Button x:Name="QuarantineButton"
                        Content="Quarantine Selected"
                        MinWidth="150"
                        Margin="0,0,10,0"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="QuarantineButton_Click"
                        Visibility="Collapsed"/>
                <Button x:Name="RemoveButton"
                        Content="Remove Selected"
                        MinWidth="140"
                        Margin="0,0,10,0"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="RemoveButton_Click"
                        Visibility="Collapsed"/>
                <Button x:Name="RestoreButton"
                        Content="Restore from Manifest..."
                        MinWidth="170"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RestoreButton_Click"
                        Visibility="Collapsed"/>
                <Button x:Name="MalwareCleanupButton"
                        Content="Malware Cleanup"
                        MinWidth="140"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="MalwareCleanupButton_Click"
                        IsEnabled="False"
                        Visibility="Collapsed"/>
                <Button x:Name="PrimaryButton"
                        Content="Cancel"
                        MinWidth="90"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="PrimaryButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

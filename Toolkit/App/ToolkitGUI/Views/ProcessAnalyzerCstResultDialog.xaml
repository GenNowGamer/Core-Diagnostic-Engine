<Window x:Class="ToolkitGUI.Views.ProcessAnalyzerCstResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CST Scan"
        Height="720"
        Width="1080"
        MinHeight="620"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundDarkBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TitleText"
                               Text="CST Scan"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="ScanKindSubtitle"
                               Text="CustomScan"
                               Margin="0,2,0,0"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="ProcessNameText"
                               Margin="0,6,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TargetPathText"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="VerdictDetailText"
                               Margin="0,10,0,0"
                               FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border x:Name="VerdictBadge"
                        Grid.Column="1"
                        Padding="14,8"
                        CornerRadius="16"
                        VerticalAlignment="Top"
                        Background="{StaticResource AccentBlueBrush}">
                    <TextBlock x:Name="VerdictText"
                               Text="Scanning..."
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="13"/>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="ProgressPanel"
                Grid.Row="1"
                Margin="0,14,0,0"
                Style="{StaticResource CardStyle}"
                Padding="20"
                Visibility="Collapsed">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ProgressPhaseText"
                               Text="Preparing scan..."
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="ProgressPercentText"
                               Grid.Column="1"
                               Text="0%"
                               FontSize="14"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               VerticalAlignment="Top"/>
                </Grid>
                <ProgressBar x:Name="ScanProgressBar"
                             Height="14"
                             Margin="0,12,0,0"
                             Minimum="0"
                             Maximum="100"
                             Value="0"/>
                <TextBlock x:Name="ProgressDetailText"
                           Margin="0,10,0,0"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="Starting Core Security Tool..."/>
                <TextBlock x:Name="ProgressPathText"
                           Margin="0,6,0,0"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <UniformGrid x:Name="MetricsPanel"
                     Grid.Row="1"
                     Margin="0,14,0,0"
                     Columns="4"
                     Visibility="Collapsed">
            <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="FILES ANALYZED" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="ItemsScannedText" Style="{StaticResource MetricValueStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="THREATS" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="ThreatsText" Style="{StaticResource MetricValueStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="WARNINGS" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="WarningsText" Style="{StaticResource MetricValueStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="SCAN ERRORS" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="ScanErrorsText" Style="{StaticResource MetricValueStyle}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <UniformGrid x:Name="StartupAxisPanel"
                     Grid.Row="1"
                     Margin="0,14,0,0"
                     Columns="3"
                     Visibility="Collapsed">
            <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="FILE" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="FileVerdictText" Style="{StaticResource MetricValueStyle}" FontSize="18" Margin="0,4,0,0"/>
                    <TextBlock x:Name="FileVerdictDetailText" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16,14" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="COMMAND LINE" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="CommandLineVerdictText" Style="{StaticResource MetricValueStyle}" FontSize="18" Margin="0,4,0,0"/>
                    <TextBlock x:Name="CommandLineVerdictDetailText" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16,14">
                <StackPanel>
                    <TextBlock Text="PERSISTENCE" Style="{StaticResource MetricLabelStyle}"/>
                    <TextBlock x:Name="PersistenceVerdictText" Style="{StaticResource MetricValueStyle}" FontSize="18" Margin="0,4,0,0"/>
                    <TextBlock x:Name="PersistenceVerdictDetailText" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border x:Name="FindingsPanel"
                Grid.Row="2"
                Margin="0,14,0,0"
                Style="{StaticResource CardStyle}"
                Padding="0"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="160"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition x:Name="SuppressedGridRow" Height="0"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource BackgroundLightBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="FindingsHeaderText"
                                       Text="Findings"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock x:Name="FindingsSubtitleText"
                                       Text="Select concrete file traces to quarantine or remove."
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock x:Name="SelectionSummaryText"
                                   Grid.Column="1"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Text="Selected: 0"/>
                    </Grid>
                </Border>

                <Border Grid.Row="1"
                        x:Name="RemediationToolbar"
                        Background="{StaticResource BackgroundLightBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="16,10"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Select Actionable"
                                MinWidth="140"
                                Margin="0,0,10,0"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="SelectActionableButton_Click"/>
                        <Button Content="Clear Selection"
                                MinWidth="120"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="ClearSelectionButton_Click"/>
                    </StackPanel>
                </Border>

                <DataGrid x:Name="FindingsGrid"
                          Grid.Row="2"
                          Margin="0,0,0,2"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserResizeColumns="True"
                          IsReadOnly="False"
                          SelectionMode="Extended"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ScrollViewer.HorizontalScrollBarVisibility="Visible"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="False"
                          CellEditEnding="FindingsGrid_CellEditEnding">
                    <DataGrid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="TextWrapping" Value="NoWrap"/>
                            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Pick"
                                                Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Width="55" MinWidth="55"/>
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" MinWidth="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100" MinWidth="100" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" MinWidth="160" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Detector" Binding="{Binding Detector}" Width="140" MinWidth="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Warning" Binding="{Binding WarningBadge}" Width="150" MinWidth="150" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceDisplay}" Width="90" MinWidth="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="480" MinWidth="320" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="480" MinWidth="320" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Note" Binding="{Binding SelectionNote}" Width="220" MinWidth="160" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="3"
                        x:Name="SuppressedHeader"
                        Visibility="Collapsed"
                        Background="{StaticResource BackgroundLightBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,1"
                        Padding="16,10">
                    <TextBlock Text="Suppressed audit findings (outside strict scope, shown for review)"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>

                <DataGrid x:Name="SuppressedGrid"
                          Grid.Row="4"
                          Margin="0,0,0,2"
                          Visibility="Collapsed"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserResizeColumns="True"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          RowHeaderWidth="0"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          ScrollViewer.HorizontalScrollBarVisibility="Visible"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="False">
                    <DataGrid.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="TextWrapping" Value="NoWrap"/>
                            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="90" MinWidth="90"/>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100" MinWidth="100"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="160" MinWidth="160"/>
                        <DataGridTextColumn Header="Detector" Binding="{Binding Detector}" Width="140" MinWidth="140"/>
                        <DataGridTextColumn Header="Warning" Binding="{Binding WarningBadge}" Width="150" MinWidth="150"/>
                        <DataGridTextColumn Header="Confidence" Binding="{Binding ConfidenceDisplay}" Width="90" MinWidth="90"/>
                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="480" MinWidth="320"/>
                        <DataGridTextColumn Header="Evidence" Binding="{Binding Evidence}" Width="480" MinWidth="320"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border x:Name="ScanningPlaceholderPanel"
                Grid.Row="2"
                Margin="0,14,0,0"
                Style="{StaticResource CardStyle}"
                Padding="24"
                Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Scan in progress"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Margin="0,8,0,0"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Text="Pre-scan checks (targets, known-good baselines, path discovery) and file analysis both report above. This panel is replaced when the scan finishes."/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,12,0,0">
            <TextBlock x:Name="ActionSummaryText"
                       Visibility="Collapsed"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="CoverageReasonText"
                       Visibility="Collapsed"
                       Margin="0,6,0,0"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>
            <ItemsControl x:Name="ErrorDetailsList"
                          Visibility="Collapsed"
                          Margin="0,8,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontSize="12"
                                   Foreground="#B45309"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="FooterHintText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="Select findings above, then Quarantine or Remove. Restore uses a CST rollback manifest."/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="CopySummaryButton"
                        Content="Copy summary"
                        MinWidth="120"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="CopySummaryButton_Click"
                        IsEnabled="False"/>
                <Button x:Name="OpenReportButton"
                        Content="Open Report"
                        MinWidth="120"
                        Margin="0,0,10,0"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="OpenReportButton_Click"
                        IsEnabled="False"/>
                <Button x:Name="QuarantineButton"
                        Content="Quarantine Selected"
                        MinWidth="150"
                        Margin="0,0,10,0"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="QuarantineButton_Click"
                        Visibility="Collapsed"/>
                <Button x:Name="RemoveButton"
                        Content="Remove Selected"
                        MinWidth="140"
                        Margin="0,0,10,0"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="RemoveButton_Click"
                        Visibility="Collapsed"/>
                <Button x:Name="RestoreButton"
                        Content="Restore from Manifest..."
                        MinWidth="170"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="RestoreButton_Click"
                        Visibility="Collapsed"/>
                <Button x:Name="MalwareCleanupButton"
                        Content="Malware Cleanup"
                        MinWidth="140"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Click="MalwareCleanupButton_Click"
                        IsEnabled="False"
                        Visibility="Collapsed"/>
                <Button x:Name="PrimaryButton"
                        Content="Cancel"
                        MinWidth="90"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="PrimaryButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

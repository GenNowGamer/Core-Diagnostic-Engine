<Window x:Class="ToolkitGUI.Views.WinPEBootMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CDE Boot Menu"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="Black"
        KeyDown="Window_KeyDown">

    <Window.Resources>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DDFFFFFF"/>
            <Setter Property="BorderBrush" Value="#22FFFFFF"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="20,13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <Border x:Name="accent" BorderBrush="#31B3FF" BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A31B3FF"/>
                                <Setter TargetName="accent" Property="BorderThickness" Value="3,0,0,0"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A31B3FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
            <Setter Property="Foreground" Value="#31B3FF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource MenuButtonStyle}">
            <Setter Property="Foreground" Value="#FF7070"/>
        </Style>

    </Window.Resources>

    <Grid>
        <!-- Splash background -->
        <Image Source="/ToolkitGUI;component/Assets/splash_1920x1080.png"
               Stretch="UniformToFill"
               Opacity="0.6"/>

        <!-- Left menu panel -->
        <Border Width="460"
                HorizontalAlignment="Left"
                Background="#E20B111A">
            <DockPanel>

                <!-- Header -->
                <StackPanel DockPanel.Dock="Top" Margin="28,32,28,20">
                    <TextBlock Text="CDE DIAGNOSTIC SUITE"
                               FontSize="12" FontWeight="Bold"
                               Foreground="#31B3FF"/>
                    <TextBlock Text="Boot Menu"
                               FontSize="30" FontWeight="Light"
                               Foreground="White"
                               Margin="0,6,0,0"/>
                    <Border Background="#2A31B3FF" Height="1" Margin="0,16,0,0"/>
                </StackPanel>

                <!-- Footer -->
                <StackPanel DockPanel.Dock="Bottom" Margin="28,12,28,20">
                    <Border Background="#1AFFFFFF" Height="1" Margin="0,0,0,10"/>
                    <TextBlock x:Name="MediaPathText"
                               Text="Media: detecting..."
                               FontSize="12"
                               Foreground="#66FFFFFF"/>
                    <TextBlock Text="Press 1-7 or click an option"
                               FontSize="11"
                               Foreground="#44FFFFFF"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Menu items -->
                <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
                    <StackPanel Margin="0,4,0,0">

                        <!-- CDE Launch -->
                        <Button x:Name="BtnNormal"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnNormalCDE_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="[1]" Width="36"
                                           Foreground="#7799BB"
                                           FontFamily="Courier New, Consolas"
                                           FontSize="14"/>
                                <TextBlock Text="Launch CDE Toolkit GUI" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnOffline"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Click="OnOfflineCDE_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="[2]" Width="36"
                                           Foreground="#7799BB"
                                           FontFamily="Courier New, Consolas"
                                           FontSize="14"/>
                                <TextBlock Text="Launch CDE + Load Offline OS" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="#1AFFFFFF" Margin="20,6"/>

                        <!-- Utilities -->
                        <Button x:Name="BtnCmd"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="OnCmdPrompt_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="[3]" Width="36"
                                           Foreground="#7799BB"
                                           FontFamily="Courier New, Consolas"
                                           FontSize="14"/>
                                <TextBlock Text="WinPE Command Prompt" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnPS"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="OnPowerShell_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="[4]" Width="36"
                                           Foreground="#7799BB"
                                           FontFamily="Courier New, Consolas"
                                           FontSize="14"/>
                                <TextBlock Text="PowerShell (WinPE)" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnNet"
                                Style="{StaticResource MenuButtonStyle}"
                                Click="OnNetConfig_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="[5]" Width="36"
                                           Foreground="#7799BB"
                                           FontFamily="Courier New, Consolas"
                                           FontSize="14"/>
                                <TextBlock Text="Network Setup (wpeinit)" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="#1AFFFFFF" Margin="20,6"/>

                        <!-- Reboot / Shutdown -->
                        <Button x:Name="BtnReboot"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="OnReboot_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="[6]" Width="36"
                                           Foreground="#7799BB"
                                           FontFamily="Courier New, Consolas"
                                           FontSize="14"/>
                                <TextBlock Text="Reboot System" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnShutdown"
                                Style="{StaticResource DangerButtonStyle}"
                                Click="OnShutdown_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="[7]" Width="36"
                                           Foreground="#7799BB"
                                           FontFamily="Courier New, Consolas"
                                           FontSize="14"/>
                                <TextBlock Text="Shutdown System" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

            </DockPanel>
        </Border>

    </Grid>
</Window>

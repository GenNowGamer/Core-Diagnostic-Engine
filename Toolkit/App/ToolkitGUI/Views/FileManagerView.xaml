<UserControl x:Class="ToolkitGUI.Views.FileManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ToolkitGUI.Views"
             Background="{StaticResource BackgroundDarkBrush}">
    <UserControl.Resources>
        <HierarchicalDataTemplate DataType="{x:Type local:FolderTreeNode}" ItemsSource="{Binding Children}">
            <TextBlock Text="{Binding Display}" Padding="2,1" TextWrapping="Wrap"/>
        </HierarchicalDataTemplate>

        <Style x:Key="FileListViewStyle" TargetType="ListView">
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="FolderTreeStyle" TargetType="TreeView">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <DataTemplate x:Key="FileSelectCellTemplate">
            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      VerticalAlignment="Center" HorizontalAlignment="Center"
                      Margin="2,0"/>
        </DataTemplate>

        <DataTemplate x:Key="FileNameCellTemplate">
            <StackPanel Orientation="Horizontal">
                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Stacked browse panes (MRI-style split view) -->
        <Grid Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="SplitSplitterRow" Height="Auto"/>
                <RowDefinition x:Name="BottomPaneRow" Height="0"/>
            </Grid.RowDefinitions>

            <!-- Top pane -->
            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TopAddressText" Grid.Row="0" FontWeight="SemiBold" Margin="0,0,0,6"
                               TextTrimming="CharacterEllipsis"/>
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TopPathBox" Grid.Column="0" Height="28" Margin="0,0,6,0"
                                 VerticalContentAlignment="Center" KeyDown="TopPathBox_KeyDown"/>
                        <Button Grid.Column="1" Content="Load" Width="64" Height="28" Margin="0,0,6,0" Click="TopLoad_Click"/>
                        <Button Grid.Column="2" Content="Up" Width="44" Height="28" Margin="0,0,6,0" Click="TopUp_Click"/>
                        <Button Grid.Column="3" Content="Refresh" Width="72" Height="28" Click="TopRefresh_Click"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" MinWidth="140"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TreeView x:Name="TopFolderTree" Grid.Column="0" Style="{StaticResource FolderTreeStyle}"
                                  SelectedItemChanged="TopFolderTree_SelectedItemChanged"
                                  TreeViewItem.Expanded="FolderTreeItem_Expanded"/>
                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                                      Background="{StaticResource TextSecondaryBrush}" Opacity="0.25"/>
                        <ListView x:Name="TopItemsListView" Grid.Column="2" Style="{StaticResource FileListViewStyle}"
                                  SelectionChanged="TopPane_SelectionChanged"
                                  MouseDoubleClick="TopItemsListView_MouseDoubleClick"
                                  PreviewMouseRightButtonUp="TopItemsListView_PreviewMouseRightButtonUp">
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="{x:Type GroupItem}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       Margin="4,10,0,4"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <ItemsPresenter/>
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ListView.GroupStyle>
                        </ListView>
                    </Grid>
                    <TextBlock x:Name="TopPaneCountText" Grid.Row="3" Margin="0,6,0,0" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </Border>

            <GridSplitter x:Name="PaneSplitter" Grid.Row="1" Height="5" HorizontalAlignment="Stretch"
                          Background="{StaticResource TextSecondaryBrush}" Opacity="0.35"
                          Visibility="Collapsed" ResizeDirection="Rows" ShowsPreview="True"/>

            <!-- Bottom pane (split view) -->
            <Border x:Name="BottomPaneBorder" Grid.Row="2" Style="{StaticResource CardStyle}" Padding="8"
                    Margin="0,6,0,0" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="BottomAddressText" Grid.Row="0" FontWeight="SemiBold" Margin="0,0,0,6"
                               TextTrimming="CharacterEllipsis"/>
                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="BottomPathBox" Grid.Column="0" Height="28" Margin="0,0,6,0"
                                 VerticalContentAlignment="Center" KeyDown="BottomPathBox_KeyDown"/>
                        <Button Grid.Column="1" Content="Load" Width="64" Height="28" Margin="0,0,6,0" Click="BottomLoad_Click"/>
                        <Button Grid.Column="2" Content="Up" Width="44" Height="28" Margin="0,0,6,0" Click="BottomUp_Click"/>
                        <Button Grid.Column="3" Content="Refresh" Width="72" Height="28" Click="BottomRefresh_Click"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" MinWidth="140"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TreeView x:Name="BottomFolderTree" Grid.Column="0" Style="{StaticResource FolderTreeStyle}"
                                  SelectedItemChanged="BottomFolderTree_SelectedItemChanged"
                                  TreeViewItem.Expanded="FolderTreeItem_Expanded"/>
                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                                      Background="{StaticResource TextSecondaryBrush}" Opacity="0.25"/>
                        <ListView x:Name="BottomItemsListView" Grid.Column="2" Style="{StaticResource FileListViewStyle}"
                                  SelectionChanged="BottomPane_SelectionChanged"
                                  MouseDoubleClick="BottomItemsListView_MouseDoubleClick"
                                  PreviewMouseRightButtonUp="BottomItemsListView_PreviewMouseRightButtonUp">
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.ContainerStyle>
                                        <Style TargetType="{x:Type GroupItem}">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type GroupItem}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontWeight="SemiBold"
                                                                       Margin="4,10,0,4"
                                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                                            <ItemsPresenter/>
                                                        </StackPanel>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </GroupStyle.ContainerStyle>
                                </GroupStyle>
                            </ListView.GroupStyle>
                        </ListView>
                    </Grid>
                    <TextBlock x:Name="BottomPaneCountText" Grid.Row="3" Margin="0,6,0,0" FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Action bar -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10">
                <Button Content="Open" Style="{StaticResource ActionButtonStyle}" Width="100" Margin="0,0,8,0" Click="OpenSelected_Click"/>
                <Button Content="Copy" Style="{StaticResource ActionButtonStyle}" Width="100" Margin="0,0,8,0" Click="CopySelected_Click"/>
                <Button Content="Move" Style="{StaticResource ActionButtonStyle}" Width="100" Margin="0,0,8,0" Click="MoveSelected_Click"/>
                <Button Content="Delete" Style="{StaticResource ActionButtonStyle}" Width="100" Margin="0,0,8,0" Click="DeleteSelected_Click"/>
                <Button Content="New Folder" Style="{StaticResource ActionButtonStyle}" Width="120" Margin="0,0,8,0" Click="NewFolder_Click"/>
                <Button x:Name="SplitViewButton" Content="Split View" Style="{StaticResource ActionButtonStyle}" Width="120" Margin="0,0,8,0" Click="SplitView_Click"/>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" Margin="12,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

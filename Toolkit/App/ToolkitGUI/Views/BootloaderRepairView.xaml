<views:WorkflowViewBase x:Class="ToolkitGUI.Views.BootloaderRepairView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ToolkitGUI.ViewModels"
             xmlns:views="clr-namespace:ToolkitGUI.Views"
             xmlns:ctrl="clr-namespace:ToolkitGUI.Controls"
             Background="{StaticResource BackgroundDarkBrush}">
    <views:WorkflowViewBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </views:WorkflowViewBase.Resources>
    <views:WorkflowViewBase.DataContext>
        <vm:DiskBootRepairViewModel/>
    </views:WorkflowViewBase.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BackgroundMidBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Disk &amp; Boot Repair" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="WinPE disk map, BCD/partition backups, and bootloader repair (bootsect, bcdboot, bcdedit)."
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding WinPeGateMessage}" FontSize="12" Foreground="OrangeRed" Margin="0,6,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ShowWinPeGateMessage}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}"
                        Style="{StaticResource ActionButtonStyle}" VerticalAlignment="Center" Padding="16,8"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="16,10" Background="{StaticResource BackgroundMidBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="DISK MAP (read-only)" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding LayoutStatus}" FontSize="12" Margin="0,4,0,0"
                                   Foreground="{StaticResource AccentBlueBrush}"/>
                    </StackPanel>
                </Border>

                <ctrl:DiskMapControl x:Name="DiskMap" Grid.Row="1" Margin="12"
                                     Disks="{Binding Disks}"
                                     SelectedPartition="{Binding SelectedPartition, Mode=TwoWay}"
                                     PartitionSelected="DiskMap_PartitionSelected"/>

                <Border Grid.Row="2" Background="{StaticResource LogBgBrush}" MaxHeight="220"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                    <TextBox Text="{Binding LogText, Mode=OneWay}"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="12" Foreground="{StaticResource LogTextBrush}"
                             Background="Transparent" BorderThickness="0"
                             IsReadOnly="True" TextWrapping="Wrap"
                             AcceptsReturn="True" Padding="12"
                             VerticalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>

            <Border Grid.Column="1" Background="{StaticResource BackgroundMidBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock Text="SELECTION" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding DetailText}" TextWrapping="Wrap" Margin="0,6,0,8" FontSize="12"/>
                        <TextBlock Text="LAST ACTION" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding HasActionSummary, Converter={StaticResource BoolToVis}}"/>
                        <TextBlock Text="{Binding ActionSummary}" TextWrapping="Wrap" Margin="0,4,0,14" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   Visibility="{Binding HasActionSummary, Converter={StaticResource BoolToVis}}"/>

                        <TextBlock Text="BACKUP" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Button Content="Backup BCD (store file)" Margin="0,6,0,4" Padding="10,8"
                                Command="{Binding RunBackupCommand}" CommandParameter="bcd"
                                Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="Backup partition table" Margin="0,0,0,4" Padding="10,8"
                                Command="{Binding RunBackupCommand}" CommandParameter="partition"
                                Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="Backup all boot artifacts" Margin="0,0,0,10" Padding="10,8"
                                Command="{Binding RunBackupCommand}" CommandParameter="all"
                                Style="{StaticResource ActionButtonStyle}"/>

                        <TextBlock Text="RESTORE BCD" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="EFI backups" FontSize="11" Margin="0,6,0,2"/>
                        <ItemsControl ItemsSource="{Binding EfiBackupFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding FileName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Checked="BackupFile_CheckedChanged" Unchecked="BackupFile_CheckedChanged"
                                              Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="BIOS backups" FontSize="11" Margin="0,8,0,2"/>
                        <ItemsControl ItemsSource="{Binding BiosBackupFiles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding FileName}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Checked="BackupFile_CheckedChanged" Unchecked="BackupFile_CheckedChanged"
                                              Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Restore selected BCD" Margin="0,8,0,14" Padding="10,8"
                                Command="{Binding RunRestoreBcdCommand}"
                                Style="{StaticResource ActionButtonStyle}"/>

                        <TextBlock Text="REPAIR" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Button Content="Check integrity" Margin="0,6,0,4" Padding="10,8"
                                Command="{Binding RunRepairCommand}" CommandParameter="BootloaderCheckIntegrity.ps1"
                                Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="Scan OS" Margin="0,0,0,4" Padding="10,8"
                                Command="{Binding RunGlobalCommand}" CommandParameter="BootloaderScanOs.ps1"
                                Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="BCD Repair" Margin="0,0,0,4" Padding="10,8"
                                Command="{Binding RunRepairCommand}" CommandParameter="BootloaderBcdRepair.ps1"
                                Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="Fix MBR (MBR disks)" Margin="0,0,0,4" Padding="10,8"
                                Command="{Binding RunRepairCommand}" CommandParameter="BootloaderFixMbr.ps1"
                                Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="Fix Boot" Margin="0,0,0,4" Padding="10,8"
                                Command="{Binding RunRepairCommand}" CommandParameter="BootloaderFixBoot.ps1"
                                Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="Rebuild BCD" Margin="0,0,0,4" Padding="10,8"
                                Command="{Binding RunRepairCommand}" CommandParameter="BootloaderRebuildBcd.ps1"
                                Style="{StaticResource ActionButtonStyle}"/>
                        <Button Content="Rebuild EFI" Margin="0,0,0,4" Padding="10,8"
                                Command="{Binding RunRepairCommand}" CommandParameter="BootloaderRebuildEfi.ps1"
                                Style="{StaticResource ActionButtonStyle}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</views:WorkflowViewBase>

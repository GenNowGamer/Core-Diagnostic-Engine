<UserControl x:Class="ToolkitGUI.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundDarkBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BackgroundMidBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel>
                <TextBlock Text="Dashboard" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Start with a symptom, run health checks, then use targeted repair tools. Work orders attach workflow runs automatically."
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
            <StackPanel>
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="RECOMMENDED WORKFLOW" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="Symptoms  →  Health Check  →  Targeted tests  →  Repair  →  Verify  →  Document"
                                   FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
                        <TextBlock x:Name="EnvironmentModeText" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,6"/>
                        <TextBlock x:Name="BootGuidanceText" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock x:Name="WorkOrderHintText" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"
                                   Margin="0,10,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Border x:Name="SymptomSectionBorder" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="WHAT ARE YOU SEEING?" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                        <TextBlock x:Name="SuggestedSymptomHintText" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBlueBrush}" TextWrapping="Wrap"
                                   Margin="0,0,0,10" Visibility="Collapsed"/>
                        <WrapPanel x:Name="SymptomButtonsPanel" Margin="0,0,0,12"/>
                        <Border x:Name="SelectedSymptomPanel" Visibility="Collapsed"
                                Background="{StaticResource BackgroundDarkBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="16">
                            <StackPanel>
                                <TextBlock x:Name="SelectedSymptomTitle" FontSize="16" FontWeight="Bold" Margin="0,0,0,6"/>
                                <TextBlock x:Name="SelectedSymptomSummary" FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
                                <Button x:Name="RunHealthChecksButton" Content="Run health checks"
                                        Style="{StaticResource ActionButtonStyle}" Height="34" Width="180"
                                        HorizontalAlignment="Left" Margin="0,0,0,12" Click="RunHealthChecks_Click"/>
                                <TextBlock Text="Suggested next tools" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                <WrapPanel x:Name="FollowUpButtonsPanel"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="SymptomUnavailableText"
                                   Text="Symptom guidance is unavailable (SymptomFlows.json not found)."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="WORK ORDER MANAGEMENT" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                            <TextBlock x:Name="WorkOrderStatusText" Text="No active work order."
                                       FontSize="14" FontWeight="SemiBold" Margin="0,0,0,16"/>

                            <TextBlock Text="Client name" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="ClientNameTextBox" Height="32" Margin="0,0,0,12"/>

                            <TextBlock Text="Client phone number" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="ClientPhoneTextBox" Height="32" Margin="0,0,0,12"/>

                            <TextBlock Text="Work order notes" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox x:Name="WorkOrderNotesTextBox" Height="100" AcceptsReturn="True"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16"/>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="GenerateWorkOrderButton"
                                        Content="Generate Work Order"
                                        Height="34"
                                        Margin="0,0,12,0"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="GenerateWorkOrder_Click"/>
                                <Button x:Name="SaveWorkOrderButton"
                                        Content="Save"
                                        Width="90"
                                        Height="34"
                                        Margin="0,0,12,0"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="SaveWorkOrder_Click"
                                        IsEnabled="False"/>
                                <Button x:Name="CloseWorkOrderButton"
                                        Content="Close Work Order"
                                        Height="34"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Click="CloseWorkOrder_Click"
                                        IsEnabled="False"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="RECENT WORK ORDERS" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                            <TextBlock Text="Five newest jobs saved on this USB. Click to open."
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                            <Button x:Name="ExportFeedbackBundleButton"
                                    Content="Export Field Feedback Zip"
                                    Height="34"
                                    Margin="0,0,0,12"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="ExportFeedbackBundle_Click"/>
                            <ItemsControl x:Name="RecentWorkOrdersList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding DisplayLabel}"
                                                Tag="{Binding CaseId}"
                                                Click="RecentWorkOrderLink_Click"
                                                Cursor="Hand"
                                                HorizontalContentAlignment="Left"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0,6"
                                                FontSize="13"
                                                Foreground="{StaticResource AccentBlueBrush}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoRecentWorkOrdersText"
                                       Text="No saved work orders yet."
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Visibility="Collapsed"/>
                            <Button x:Name="ClearRecentWorkOrdersButton"
                                    Content="Clear Recent"
                                    Height="32"
                                    MinWidth="120"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="ClearRecentWorkOrders_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="CaseTimelineBorder" Style="{StaticResource CardStyle}" Margin="0,16,0,0" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="CASE TIMELINE" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                        <TextBlock Text="Newest events first for the active work order."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                        <ItemsControl x:Name="CaseTimelineList"/>
                        <TextBlock x:Name="NoTimelineText" Text="No recorded events yet."
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Visibility="Collapsed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

<UserControl x:Class="ToolkitGUI.Views.CstFindingsExpander"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ToolkitGUI.Views">
    <Border Margin="12,10,12,12"
            Padding="12"
            Background="{StaticResource BackgroundDarkBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <StackPanel>
            <ToggleButton x:Name="ExpandToggle"
                          Content="Show all findings and scan details"
                          Padding="10,6"
                          HorizontalAlignment="Left"
                          Click="ExpandToggle_Click"/>
            <StackPanel x:Name="ExpandedPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock x:Name="MetadataText"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,10"/>
                <DataGrid x:Name="FindingsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="Transparent"
                          BorderThickness="0"
                          MaxHeight="280">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
                        <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="80"/>
                        <DataGridTextColumn Header="Detector" Binding="{Binding Detector}" Width="100"/>
                        <DataGridTextColumn Header="Confidence" Binding="{Binding Confidence, StringFormat={}{0:0.00}}" Width="80"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Content="Open full CST report (PDF)"
                        Margin="0,10,0,0"
                        Padding="12,6"
                        HorizontalAlignment="Left"
                        Style="{StaticResource ActionButtonStyle}"
                        Click="OpenReport_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>

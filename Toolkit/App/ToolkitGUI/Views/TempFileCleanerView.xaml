<views:WorkflowViewBase x:Class="ToolkitGUI.Views.TempFileCleanerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ToolkitGUI.Views"
             xmlns:controls="clr-namespace:ToolkitGUI.Controls"
             Background="{StaticResource BackgroundDarkBrush}"
             TextElement.Foreground="{StaticResource TextPrimaryBrush}">
    <views:WorkflowViewBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </views:WorkflowViewBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMidBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="🧹  Temp File Cleaner" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Scan and selectively remove temporary files from all user profiles and system locations."
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <controls:ResponsiveToolbar HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="🔍  Scan" Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding ScanCommand}" Padding="18,9" Margin="0,0,8,6"
                            IsEnabled="{Binding IsIdle}"/>
                    <Button Content="🗑  Clean Selected" Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding CleanCommand}" Padding="18,9" Margin="0,0,0,6"
                            IsEnabled="{Binding IsIdle}"/>
                </controls:ResponsiveToolbar>
            </Grid>
        </Border>

        <!-- Drive scope -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundMidBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="DRIVES" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <ItemsControl ItemsSource="{Binding AvailableDrives}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding DisplayName}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      Margin="0,0,16,0"
                                      VerticalAlignment="Center"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource BackgroundMidBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <controls:ResponsiveToolbar VerticalAlignment="Center">
                <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,6"/>
                <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" Margin="0,0,20,6"/>
                <ProgressBar IsIndeterminate="True" Width="140" Height="6" VerticalAlignment="Center" Margin="0,0,0,6"
                             Foreground="{StaticResource AccentBlueBrush}" BorderThickness="0"
                             Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
            </controls:ResponsiveToolbar>
        </Border>

        <!-- Scan Results Tree -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Column headers -->
            <Border Grid.Row="0" Background="{StaticResource BackgroundLightBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                <Grid Height="34" Margin="10,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1" Text="✓" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="LOCATION" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" Text="FILES" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="4" Text="SIZE" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0"/>
                    <TextBlock Grid.Column="5" Text="PATH" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>
            </Border>

            <!-- Expandable tree view -->
            <TreeView Grid.Row="1" ItemsSource="{Binding Folders}"
                      Background="White" BorderThickness="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingStackPanel.IsVirtualizing="True">
                <TreeView.Resources>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="TreeViewItem">
                                    <StackPanel>
                                        <Border x:Name="RowBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,0,0,1">
                                            <ContentPresenter ContentSource="Header"
                                                              HorizontalAlignment="Stretch"/>
                                        </Border>
                                        <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed"/>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsExpanded" Value="True">
                                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="#EEF3F8"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <!-- Child rows get a slightly off-white background -->
                            <DataTrigger Binding="{Binding IsParent}" Value="False">
                                <Setter Property="Background" Value="#F9FAFC"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TreeView.Resources>

                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <Grid Height="34" Margin="10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="32"/>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Expand / collapse toggle (parent rows only) -->
                            <ToggleButton Grid.Column="0"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay}"
                                          Visibility="{Binding IsParent, Converter={StaticResource BoolToVis}}"
                                          Focusable="False"
                                          Width="20" Height="20"
                                          HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Width="20" Height="20" CornerRadius="2">
                                            <TextBlock x:Name="Arrow" Text="▶" FontSize="9"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Text" Value="▼"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Select checkbox -->
                            <CheckBox Grid.Column="1"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>

                            <!-- Location / user name -->
                            <TextBlock Grid.Column="2"
                                       Text="{Binding DisplayName}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontSize" Value="12"/>
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsParent}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="13"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- File count -->
                            <TextBlock Grid.Column="3"
                                       Text="{Binding FileCount}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="0,0,8,0"
                                       FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>

                            <!-- Size (blue for parent totals, grey for children) -->
                            <TextBlock Grid.Column="4"
                                       Text="{Binding SizeDisplay}"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" Margin="0,0,8,0"
                                       FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsParent}" Value="False">
                                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Full path (child rows) -->
                            <TextBlock Grid.Column="5"
                                       Text="{Binding Path}"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="8,0,0,0"/>
                        </Grid>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <!-- Summary footer -->
        <Border Grid.Row="4" Background="{StaticResource BackgroundMidBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="14,10">
            <TextBlock x:Name="SummaryText" FontSize="13" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </Border>
    </Grid>
</views:WorkflowViewBase>

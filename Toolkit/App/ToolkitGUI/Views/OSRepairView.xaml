<views:WorkflowViewBase x:Class="ToolkitGUI.Views.OSRepairView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ToolkitGUI.ViewModels"
             xmlns:views="clr-namespace:ToolkitGUI.Views"
             xmlns:controls="clr-namespace:ToolkitGUI.Controls"
             Background="{StaticResource BackgroundDarkBrush}">
    <views:WorkflowViewBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </views:WorkflowViewBase.Resources>
    <views:WorkflowViewBase.DataContext>
        <vm:OSRepairViewModel/>
    </views:WorkflowViewBase.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header (white) -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMidBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel>
                <TextBlock Text="🔧  OS Repair" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="SFC, DISM, network reset, and Windows Update repair workflows."
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Body: Tool list (left) + Output panel (right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tool List (white panel) -->
            <Border Grid.Column="0" Background="{StaticResource BackgroundMidBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Tools}" Margin="14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="5"
                                        Padding="14,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                       Foreground="{StaticResource AccentBlueBrush}"
                                                       FontStyle="Italic" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding ActionButtonLabel}"
                                                Command="{Binding RunCommand}"
                                                Style="{StaticResource ActionButtonStyle}"
                                                VerticalAlignment="Center"
                                                Padding="14,8"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Output Panel (dark terminal) -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Status bar -->
                <Border Grid.Row="0" Background="{StaticResource BackgroundMidBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                    <controls:ResponsiveToolbar>
                        <TextBlock Text="OUTPUT" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,16,6"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBlueBrush}"
                                   VerticalAlignment="Center" Margin="0,0,20,6"/>
                        <ProgressBar Value="{Binding Progress}" Maximum="100" Width="160" Height="6"
                                     VerticalAlignment="Center" Margin="0,0,0,6"
                                     Background="{StaticResource BackgroundLightBrush}"
                                     Foreground="{StaticResource AccentBlueBrush}"
                                     BorderThickness="0"
                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                    </controls:ResponsiveToolbar>
                </Border>

                <!-- Dark log terminal -->
                <Grid Grid.Row="1" Background="{StaticResource LogBgBrush}">
                    <TextBox Text="{Binding LogText, Mode=OneWay}"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="13" Foreground="{StaticResource LogTextBrush}"
                             Background="Transparent" BorderThickness="0"
                             IsReadOnly="True" TextWrapping="Wrap"
                             AcceptsReturn="True" Padding="20"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</views:WorkflowViewBase>

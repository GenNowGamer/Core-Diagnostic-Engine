<views:WorkflowViewBase x:Class="ToolkitGUI.Views.FastFixesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:ToolkitGUI.Views"
             Background="{StaticResource BackgroundDarkBrush}"
             TextElement.Foreground="{StaticResource TextPrimaryBrush}">
    <views:WorkflowViewBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </views:WorkflowViewBase.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMidBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel>
                <TextBlock Text="⚡  Fast Fixes" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="One-click fixes for common Networking, OS, Services, Browser, and Performance issues."
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Body: Category sidebar (left) + Fix list + output (right) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Category List -->
            <Border Grid.Column="0" Background="{StaticResource BackgroundMidBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="CATEGORY" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="14,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding}" Tag="{Binding}"
                                        Click="Category_Click"
                                        Height="36" HorizontalContentAlignment="Left"
                                        Padding="14,0" FontSize="13"
                                        Background="Transparent" BorderThickness="0"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Cursor="Hand"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Fix Cards -->
            <Border Grid.Column="1" Background="{StaticResource BackgroundMidBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ShownFixes}" Margin="14">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="5" Padding="14,12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"/>
                                                <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="3">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#E8F5E9"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Risk}" Value="Caution">
                                                                    <Setter Property="Background" Value="#FFF8E1"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Risk}" FontSize="10" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#0D7A3E"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Risk}" Value="Caution">
                                                                        <Setter Property="Foreground" Value="#926800"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Description}" FontSize="12"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{Binding ActionLabel}"
                                                Tag="{Binding}" Click="Apply_Click"
                                                Style="{StaticResource ActionButtonStyle}"
                                            VerticalAlignment="Center" Padding="14,8"
                                            IsEnabled="{Binding IsApplicable}"
                                            ToolTip="{Binding AvailabilityNote}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Output panel -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource BackgroundMidBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="OUTPUT" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBlueBrush}"
                                   VerticalAlignment="Center" Margin="0,0,20,0"/>
                        <ProgressBar Value="{Binding Progress}" Maximum="100" Width="140" Height="6"
                                     VerticalAlignment="Center"
                                     Background="{StaticResource BackgroundLightBrush}"
                                     Foreground="{StaticResource AccentBlueBrush}" BorderThickness="0"
                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
                <Grid Grid.Row="1" Background="{StaticResource LogBgBrush}">
                    <TextBox Text="{Binding LogText, Mode=OneWay}"
                             FontFamily="Cascadia Code, Consolas, Courier New"
                             FontSize="13" Foreground="{StaticResource LogTextBrush}"
                             Background="Transparent" BorderThickness="0"
                             IsReadOnly="True" TextWrapping="Wrap"
                             AcceptsReturn="True" Padding="20"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</views:WorkflowViewBase>

<Window x:Class="ToolkitGUI.Views.WorkflowExecutionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:ToolkitGUI.Views"
        Title="Workflow Execution"
        Height="760"
        Width="1080"
        MinHeight="680"
        MinWidth="920"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundDarkBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding OperationTitle}"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding OperationDescription}"
                               Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="12,8"
                        CornerRadius="16"
                        Background="{Binding ResultStatusBrush}"
                        VerticalAlignment="Top">
                    <TextBlock Text="{Binding ResultStatusLabel}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Style="{StaticResource CardStyle}"
                Padding="18,16">
            <StackPanel>
                <DockPanel>
                    <TextBlock Text="{Binding PhaseText}"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               DockPanel.Dock="Left"/>
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               DockPanel.Dock="Right"/>
                </DockPanel>
                <Grid Margin="0,12,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Grid.Column="0"
                                 Value="{Binding Progress}"
                                 Maximum="100"
                                 Height="12"
                                 Background="{StaticResource BackgroundLightBrush}"
                                 Foreground="{StaticResource AccentBlueBrush}"
                                 BorderThickness="0"/>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ProgressPercentText}"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </Grid>
                <TextBlock Text="{Binding ProgressCaption}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Style="{StaticResource CardStyle}"
                Padding="18,16"
                Visibility="{Binding HasStructuredResult, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Summary"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="{Binding ResultSummary}"
                               Margin="0,6,0,0"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ResultDetails}"
                               Margin="0,8,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Errors"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ItemsControl ItemsSource="{Binding ResultErrors}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,6,0,0"
                                        Padding="10,8"
                                        CornerRadius="4"
                                        Background="#FFF4F2"
                                        BorderBrush="#F1B5AE"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding}"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource AccentRedBrush}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="No reported errors."
                               Margin="0,6,0,0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Visibility="{Binding HasResultErrors, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Artifacts"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Button Content="Open Report"
                            Margin="0,8,0,0"
                            Padding="12,8"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="OpenPdfReportButton_Click"
                            IsEnabled="{Binding CanOpenPdfReport}"/>
                    <Button Content="Copy Live Log"
                            Margin="0,8,0,0"
                            Padding="12,8"
                            Style="{StaticResource ActionButtonStyle}"
                            Click="CopyLogButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.8*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{StaticResource BackgroundLightBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <TextBlock Text="Structured Results"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Margin="12,12,12,0"
                                       Text="Items found by the scan appear below in a compact (read-only) list."
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                            <ItemsControl ItemsSource="{Binding StructuredResultItems}"
                                          Margin="12,10,12,0"
                                          ItemTemplate="{StaticResource FormattedResultItemTemplate}"/>
                            <views:CstFindingsExpander x:Name="CstExpander" Visibility="Collapsed"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Margin="14,0,0,0"
                    Style="{StaticResource CardStyle}"
                    Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="{StaticResource BackgroundLightBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,12">
                        <TextBlock Text="Live Execution Stream"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </Border>
                    <Grid Grid.Row="1" Background="{StaticResource LogBgBrush}">
                        <TextBox x:Name="LiveLogTextBox"
                                 Text="{Binding LogText}"
                                 FontFamily="Cascadia Code, Consolas, Courier New"
                                 FontSize="13"
                                 Foreground="{StaticResource LogTextBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Padding="18"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="{Binding FooterText}"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"/>

                <Button Grid.Column="1"
                    Content="Stop Scan"
                    MinWidth="120"
                    Margin="0,0,8,0"
                    Padding="14,8"
                    Style="{StaticResource ActionButtonStyle}"
                    IsEnabled="{Binding IsRunning}"
                    Click="StopButton_Click"/>

                <Button Grid.Column="2"
                    Content="Close"
                    MinWidth="120"
                    Padding="14,8"
                    Style="{StaticResource ActionButtonStyle}"
                    Click="CloseButton_Click"/>
        </Grid>
    </Grid>
</Window>

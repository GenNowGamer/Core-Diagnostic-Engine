<Window x:Class="ToolkitGUI.Views.RobocopyConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Robocopy Backup Configuration"
        Height="620"
        Width="980"
        MinHeight="560"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundDarkBrush}">
    <Window.Resources>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D7DFEA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#E1E6EF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#CCD4E0"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Configure Robocopy Backup"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Margin="0,6,0,0"
                               Text="Set the source, destination, and backup behavior before launching the workflow."
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="12,8"
                        CornerRadius="16"
                        Background="{StaticResource AccentBlueBrush}"
                        VerticalAlignment="Top">
                    <TextBlock Text="Backup Ready"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="0,14,0,0"
                Style="{StaticResource CardStyle}"
                Padding="18,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Source Folder" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="SourcePathText" Text="(none selected)"
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="2" Content="Browse..." Margin="12,0,0,0" MinWidth="100"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BrowseSourceButton_Click"/>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Destination Folder" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" x:Name="DestPathText" Text="(none selected)"
                               Margin="12,0,0,0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="2" Content="Browse..." Margin="12,0,0,0" MinWidth="100"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BrowseDestButton_Click"/>
                </Grid>

                <Border Grid.Row="2"
                        Background="{StaticResource BackgroundMidBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="14"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Options" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

                        <CheckBox x:Name="DryRunCheckBox" Margin="0,0,0,10" VerticalAlignment="Center">
                            <TextBlock>
                                <Run FontWeight="SemiBold" Text="Dry Run"/>
                                <Run Foreground="{StaticResource TextSecondaryBrush}" Text=" — No files will be copied, only show what would happen"/>
                            </TextBlock>
                        </CheckBox>

                        <CheckBox x:Name="MirrorCheckBox" VerticalAlignment="Center">
                            <TextBlock>
                                <Run FontWeight="SemiBold" Text="Mirror Mode"/>
                                <Run Foreground="{StaticResource TextSecondaryBrush}" Text=" — Remove files in destination that no longer exist in source"/>
                            </TextBlock>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="3"
                           Text="Mirror mode is recommended for complete backups. Dry run is useful for previewing changes before committing."
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Style="{StaticResource CardStyle}"
                Padding="14,10">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                   VerticalAlignment="Center"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="Preview runs the backup in dry-run mode so you can verify changes before committing."
                   TextWrapping="Wrap"
                   Margin="0,0,12,0"/>

            <Button Grid.Column="1" Content="Cancel" MinWidth="78" Margin="0,0,8,0"
                Padding="12,6"
                Style="{StaticResource SecondaryButtonStyle}"
                IsCancel="True" Click="CancelButton_Click"/>
            <Button Grid.Column="2" Content="Preview" MinWidth="78" Margin="0,0,8,0"
                Padding="12,6"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="PreviewButton_Click" ToolTip="Run as dry run to preview changes"/>
            <Button Grid.Column="3" Content="Start Backup" MinWidth="108"
                Padding="12,6"
                Style="{StaticResource ActionButtonStyle}"
                IsDefault="True" Click="StartButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>

<UserControl x:Class="ToolkitGUI.Views.UninstallManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ToolkitGUI.Controls"
             Background="{StaticResource BackgroundDarkBrush}"
             TextElement.Foreground="{StaticResource TextPrimaryBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMidBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="📦  Uninstall Manager" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="View installed programs. Uninstall prefers quiet/MSI paths and checks leftovers; Force Remove clears ARP entries with optional folder cleanup."
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="↻  Refresh" Style="{StaticResource ActionButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Command="{Binding RefreshCommand}" Padding="18,9"/>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundMidBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,8">
            <controls:ResponsiveToolbar>
                <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,6"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox Width="280" MinWidth="160" Height="30" Margin="0,0,16,6"
                         Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                         Padding="8,6" FontSize="13"
                         Background="{StaticResource BackgroundLightBrush}"
                         BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"/>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="13" Margin="0,0,0,6"
                           Foreground="{StaticResource AccentBlueBrush}" FontWeight="SemiBold"/>
            </controls:ResponsiveToolbar>
        </Border>

        <!-- Programs Grid -->
        <DataGrid Grid.Row="2"
                  ItemsSource="{Binding FilteredPrograms}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  AlternationCount="2"
                  Background="White" BorderThickness="0"
                  ColumnHeaderHeight="34"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                  CanUserResizeRows="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Setter Property="Background" Value="White"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="#E3F0FB"/>
                        </Trigger>
                        <Trigger Property="AlternationIndex" Value="1">
                            <Setter Property="Background" Value="#F8FAFC"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Padding" Value="10,0"/>
                    <Setter Property="Height" Value="34"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="NAME"         Binding="{Binding Name}"        Width="2*" MinWidth="120"/>
                <DataGridTextColumn Header="PUBLISHER"    Binding="{Binding Publisher}"   Width="1.5*" MinWidth="100"/>
                <DataGridTextColumn Header="VERSION"      Binding="{Binding Version}"     Width="*" MinWidth="70"/>
                <DataGridTextColumn Header="INSTALL DATE" Binding="{Binding InstallDate}" Width="*" MinWidth="90"/>
                <DataGridTextColumn Header="SIZE"         Binding="{Binding SizeDisplay}" Width="*" MinWidth="70"/>
                <DataGridTextColumn Header="ARCH"         Binding="{Binding Arch}"        Width="Auto" MinWidth="50"/>
                <DataGridTemplateColumn Header="ACTIONS" Width="Auto" MinWidth="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,2">
                                <Button Content="Uninstall" Tag="{Binding}" Click="Uninstall_Click"
                                        IsEnabled="{Binding HasUninstaller}"
                                        ToolTip="Runs QuietUninstallString when available, otherwise quiet MSI (msiexec /qn), otherwise UninstallString. Then checks for leftovers."
                                        Padding="8,4" Margin="0,0,4,0" FontSize="11"
                                        Background="{StaticResource AccentBlueBrush}" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"/>
                                <Button Content="Force Remove" Tag="{Binding}" Click="ForceRemove_Click"
                                        ToolTip="Removes the ARP uninstall registry key. Optionally delete the install folder, then review leftover folder matches. Not a full product wipe by itself."
                                        Padding="8,4" FontSize="11"
                                        Background="{StaticResource AccentRedBrush}" Foreground="White"
                                        BorderThickness="0" Cursor="Hand"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Loading overlay -->
        <Border Grid.Row="2" Background="#80FFFFFF"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Loading programs..." FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBlueBrush}" HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="6" Margin="0,12,0,0"
                             Foreground="{StaticResource AccentBlueBrush}" BorderThickness="0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

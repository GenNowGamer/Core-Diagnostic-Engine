<Window x:Class="ToolkitGUI.Views.CoreSecurityToolConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Core Security Tool"
        Height="620"
        Width="720"
        MinHeight="520"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="{StaticResource BackgroundDarkBrush}">
    <Window.Resources>
        <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#D7DFEA"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Background" Value="#E1E6EF"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="#CCD4E0"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Core Security Tool"
                               FontSize="24"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Margin="0,6,0,0"
                               Text="Configure scan mode and detection scope. Remediation is selected after scan results load."
                               FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="12,8"
                        CornerRadius="16"
                        Background="{StaticResource AccentBlueBrush}"
                        VerticalAlignment="Top">
                    <TextBlock Text="Ready"
                               Foreground="White"
                               FontWeight="SemiBold"
                               FontSize="12"/>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Margin="0,14,0,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>
                    <Border Style="{StaticResource CardStyle}" Padding="18,16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Scan Type" Style="{StaticResource SectionLabelStyle}"/>
                            <ComboBox x:Name="ScanTypeComboBox" Grid.Row="0" Grid.Column="1" SelectedIndex="0" Margin="12,0,0,10" SelectionChanged="ScanTypeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Quick Scan" Tag="ThreatScan"/>
                                <ComboBoxItem Content="Full Scan" Tag="FullScan"/>
                                <ComboBoxItem Content="Custom Scan" Tag="CustomScan"/>
                            </ComboBox>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Detection Scope" Style="{StaticResource SectionLabelStyle}"/>
                            <ComboBox x:Name="DetectionScopeComboBox"
                                      Grid.Row="1"
                                      Grid.Column="1"
                                      SelectedIndex="0"
                                      Margin="12,0,0,10"
                                      SelectionChanged="DetectionScopeComboBox_SelectionChanged">
                                <ComboBoxItem Content="All Detections" Tag="All"/>
                                <ComboBoxItem Content="Malware Only" Tag="MalwareOnly"/>
                                <ComboBoxItem Content="Virus Only" Tag="VirusOnly"/>
                            </ComboBox>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Remediation Mode" Style="{StaticResource SectionLabelStyle}"/>
                            <TextBlock Grid.Row="2"
                                       Grid.Column="1"
                                       Margin="12,2,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="Scan only first. Choose Quarantine or Remove from the post-scan findings dialog."/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="18,16" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="Threat Signature Database"
                                           Style="{StaticResource SectionLabelStyle}"/>
                                <TextBlock Margin="0,6,0,0"
                                           Text="Download the latest malware hash IOCs from the CDE threat rules feed before scanning."
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    x:Name="UpdateHashIocButton"
                                    Content="Update Hash IOCs"
                                    MinWidth="150"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ActionButtonStyle}"
                                    Click="UpdateHashIocButton_Click"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Custom Scan Targets" Style="{StaticResource SectionLabelStyle}" DockPanel.Dock="Left"/>
                                <TextBlock x:Name="TargetHintText"
                                           Text="(used only when Scan Type = Custom Scan)"
                                           DockPanel.Dock="Right"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </DockPanel>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button x:Name="AddTargetButton"
                                        Content="Add Folder..."
                                        MinWidth="130"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="AddTargetButton_Click"
                                        IsEnabled="False"/>
                                <Button x:Name="RemoveTargetButton"
                                        Content="Remove Selected"
                                        MinWidth="140"
                                        Margin="0,0,8,0"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="RemoveTargetButton_Click"
                                        IsEnabled="False"/>
                                <Button x:Name="ClearTargetsButton"
                                        Content="Clear"
                                        MinWidth="90"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="ClearTargetsButton_Click"
                                        IsEnabled="False"/>
                            </StackPanel>

                            <ListBox Grid.Row="2"
                                     x:Name="TargetsListBox"
                                     SelectionChanged="TargetsListBox_SelectionChanged"
                                     MaxHeight="130"
                                     BorderBrush="{StaticResource BorderBrush}"
                                     BorderThickness="1"
                                     Background="White"
                                     Margin="0,0,0,10"/>

                            <TextBlock Grid.Row="3"
                                       x:Name="TargetsValidationText"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Style="{StaticResource CardStyle}"
                Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Open and Run performs scan-only. After results load, select findings and choose Quarantine or Remove."/>

                <Button Grid.Column="1"
                        Content="Cancel"
                        MinWidth="110"
                        Margin="0,0,10,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        IsCancel="True"
                        Click="CancelButton_Click"/>

                <Button Grid.Column="2"
                        Content="Open and Run"
                        MinWidth="150"
                        Style="{StaticResource ActionButtonStyle}"
                        IsDefault="True"
                        Click="RunButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>

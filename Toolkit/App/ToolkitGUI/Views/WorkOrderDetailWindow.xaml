<Window x:Class="ToolkitGUI.Views.WorkOrderDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Work Order"
        Height="720"
        Width="960"
        MinHeight="560"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundDarkBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="20">
            <StackPanel>
                <TextBlock x:Name="CaseIdText" FontSize="22" FontWeight="Bold"/>
                <TextBlock x:Name="StatusText" Margin="0,6,0,0" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="0,14,0,0" Style="{StaticResource CardStyle}" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                    <TextBlock Text="CLIENT NAME" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="ClientNameText" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,12">
                    <TextBlock Text="CLIENT PHONE" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="ClientPhoneText" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                    <TextBlock Text="WORK ORDER NOTES" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="NotesText" FontSize="14" TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource CardStyle}" Padding="16">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="TOOLS / SCANS (KEY RESULTS)"
                           FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="RunsItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,12" Padding="14"
                                        Background="{StaticResource BackgroundMidBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding TimelineLabel}" FontSize="15" FontWeight="SemiBold"/>
                                                <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ShowEventKindChip}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="Event: "/>
                                                    <Run Text="{Binding EventKind}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding OverallHealth}" FontWeight="SemiBold"
                                                       HorizontalAlignment="Right" Foreground="{StaticResource AccentBlueBrush}"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding CompletedAt}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasOpenableLinks}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Content="Open Report" Tag="{Binding ReportPdf}" Margin="0,0,8,0"
                                                    Padding="10,4"
                                                    Click="OpenTimelineLink_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ActionButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasOpenableReport}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding KeyFindings}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,0,0,6">
                                                        <TextBlock FontSize="13" TextWrapping="Wrap">
                                                            <Run Text="&#x2022; " />
                                                            <Run Text="{Binding Step}" FontWeight="SemiBold"/>
                                                            <Run Text=" (" />
                                                            <Run Text="{Binding Status}"/>
                                                            <Run Text="): " />
                                                            <Run Text="{Binding Detail}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Button Grid.Row="3" Content="Close" Width="100" Height="34" Margin="0,14,0,0"
                HorizontalAlignment="Right" Style="{StaticResource ActionButtonStyle}"
                Click="CloseButton_Click"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,14,0,0">
            <Button x:Name="OpenFinalReportButton" Content="Open Final Report" Width="150" Height="34"
                    Margin="0,0,8,0" Style="{StaticResource ActionButtonStyle}"
                    Click="OpenFinalReport_Click" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Window>

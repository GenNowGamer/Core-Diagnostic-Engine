<Window x:Class="ToolkitGUI.Views.CstRemediationProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CST Remediation"
        Height="420"
        Width="560"
        MinHeight="320"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource BackgroundDarkBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Text="Remediating selected findings"/>

        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Margin="0,6,0,10"
                   FontSize="13"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="Preparing..."
                   TextWrapping="Wrap"/>

        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="0"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <ListBox x:Name="ItemsList"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Top"
                                       Text="{Binding Status}"
                                       Foreground="{Binding StatusBrush}"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Location}"
                                           Margin="0,2,0,0"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Location}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ProgressBar x:Name="ProgressBar"
                         Grid.Row="0"
                         Height="18"
                         Minimum="0"
                         Maximum="100"
                         Value="0"/>
            <TextBlock x:Name="ProgressPercentText"
                       Grid.Row="1"
                       Margin="0,6,0,0"
                       FontSize="12"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       Text="0%"/>
        </Grid>
    </Grid>
</Window>

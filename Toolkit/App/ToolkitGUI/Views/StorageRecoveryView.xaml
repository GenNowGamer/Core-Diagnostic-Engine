<UserControl x:Class="ToolkitGUI.Views.StorageRecoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:ToolkitGUI.Controls"
             Background="{StaticResource BackgroundDarkBrush}"
             TextElement.Foreground="{StaticResource TextPrimaryBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="RecoveryGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource BackgroundLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="32"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ HEADER BAR ═══ -->
        <Border Grid.Row="0" Background="{StaticResource BackgroundMidBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🗄  Storage Recovery — Partition &amp; File System Diagnostics" FontSize="21" FontWeight="Bold"/>
                        <Border CornerRadius="4" Padding="10,4" Margin="14,0,0,0" VerticalAlignment="Center"
                                Background="{Binding OverallVerdictBrush}">
                            <TextBlock Text="{Binding OverallVerdict}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Read-only physical disk and image sector inspection, Primary/Backup GPT &amp; NTFS VBR validation, binary metadata snapshots, and guided repairs."
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="💿 S.M.A.R.T. Analyzer" Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding NavigateSmartAnalyzerCommand}" Padding="12,7" Margin="0,0,8,0"/>
                    <Button Content="💾 Backup &amp; Imaging" Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding NavigateBackupImagingCommand}" Padding="12,7" Margin="0,0,8,0"/>
                    <Button Content="📄 Open PDF Report" Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding OpenPdfReportCommand}" Padding="12,7"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ DEVICE SELECTOR & FIXTURE TOOLBAR ═══ -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundMidBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <controls:ResponsiveToolbar Grid.Row="0">
                    <TextBlock Text="Target Device:" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <ComboBox Width="440" Height="32" VerticalContentAlignment="Center" Margin="0,0,8,6"
                              ItemsSource="{Binding Targets}"
                              SelectedItem="{Binding SelectedTarget}"
                              DisplayMemberPath="DisplayTitle"/>
                    <Button Content="▶  Inspect Disk (Read-Only)" Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding InspectTargetCommand}" Padding="16,7" Margin="0,0,8,6"/>
                    <Button Content="↻  Refresh Drives" Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding RefreshDisksCommand}" Padding="12,7" Margin="0,0,8,6"/>
                    <Button Content="📂  Open Disk Image (.img)" Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding OpenImageFileCommand}" Padding="12,7" Margin="0,0,14,6"/>

                    <TextBlock Text="Test Fixture:" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,6,6"
                               Visibility="{Binding ShowTestFixtureControls, Converter={StaticResource BoolToVis}}"/>
                    <ComboBox Width="300" Height="30" VerticalContentAlignment="Center" Margin="0,0,6,6"
                              ItemsSource="{Binding FixturePresets}"
                              SelectedItem="{Binding SelectedFixturePreset}"
                              Visibility="{Binding ShowTestFixtureControls, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="🧪 Create &amp; Inspect Fixture" Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding CreateTestFixtureCommand}" Padding="12,6" Margin="0,0,0,6"
                            Visibility="{Binding ShowTestFixtureControls, Converter={StaticResource BoolToVis}}"/>
                </controls:ResponsiveToolbar>

                <!-- Status & Read-Only Badges Row -->
                <Grid Grid.Row="1" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="Hardware:" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Border CornerRadius="3" Padding="8,2" Background="{Binding HardwareBadgeBrush}">
                            <TextBlock Text="{Binding HardwareBadge}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="Partition Table:" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Border CornerRadius="3" Padding="8,2" Background="{Binding PartitionBadgeBrush}">
                            <TextBlock Text="{Binding PartitionBadge}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,16,0">
                        <TextBlock Text="File Systems:" FontSize="11.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Border CornerRadius="3" Padding="8,2" Background="{Binding FileSystemBadgeBrush}">
                            <TextBlock Text="{Binding FileSystemBadge}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBlueBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ 5-STAGE WORKFLOW BAR ═══ -->
        <Border Grid.Row="2" Background="#F5F8FC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,8">
            <ItemsControl ItemsSource="{Binding WorkflowStages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" Columns="5"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="4" Padding="10,6" Margin="0,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Border Grid.Column="1" CornerRadius="3" Padding="6,2" VerticalAlignment="Top" Background="{Binding BadgeBackground}">
                                    <TextBlock Text="{Binding StateLabel}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- ═══ 6-TAB MAIN WORKSPACE ═══ -->
        <TabControl Grid.Row="3" SelectedIndex="{Binding SelectedTabIndex}" Margin="14,10,14,14"
                    Background="White" BorderBrush="{StaticResource BorderBrush}">

            <!-- TAB 1: OVERVIEW -->
            <TabItem Header="  1. Overview &amp; Findings  ">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F0F6FF" BorderBrush="#B4D2F5" BorderThickness="1" CornerRadius="5" Padding="14,10" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="READ-ONLY DIAGNOSTIC PROTECTION &amp; EXECUTIVE ASSESSMENT" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}"/>
                            <TextBlock Text="{Binding SelectedDeviceSummary}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,2"/>
                            <TextBlock Text="{Binding ExecutiveSummary}" FontSize="12.5" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Findings}" AutoGenerateColumns="False" IsReadOnly="True"
                              ColumnHeaderStyle="{StaticResource RecoveryGridHeaderStyle}"
                              Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              CanUserResizeRows="False">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="STATUS" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" FontWeight="Bold" Foreground="{Binding StatusBrush}" Margin="8,0" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="95"/>
                            <DataGridTextColumn Header="CLASSIFICATION" Binding="{Binding Classification}" Width="140"/>
                            <DataGridTextColumn Header="CONF" Binding="{Binding Confidence, StringFormat={}{0}%}" Width="65"/>
                            <DataGridTextColumn Header="OFFSET" Binding="{Binding OffsetDisplay}" Width="135"/>
                            <DataGridTextColumn Header="FINDING" Binding="{Binding Title}" Width="240"/>
                            <DataGridTextColumn Header="EVIDENCE" Binding="{Binding EvidenceSummary}" Width="*"/>
                            <DataGridTextColumn Header="RECOMMENDED ACTION" Binding="{Binding Recommendation}" Width="240"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 2: PARTITION MAP -->
            <TabItem Header="  2. Partition Map (MBR / GPT / Lost)  ">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="RAW-SECTOR PARTITION VISUALIZATION" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <controls:DiskMapControl Disks="{Binding RawDiskMapCollection}" Height="90" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="PRIMARY VS. BACKUP GPT &amp; SECTOR 0 COMPARISON" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding GptComparisonSummary, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                     FontFamily="Cascadia Code, Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="2" ItemsSource="{Binding DiscoveredPartitions}" AutoGenerateColumns="False" IsReadOnly="True"
                              ColumnHeaderStyle="{StaticResource RecoveryGridHeaderStyle}"
                              Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="IN ACTIVE TABLE" Binding="{Binding InActivePartitionTable}" Width="115"/>
                            <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="210"/>
                            <DataGridTextColumn Header="TYPE / FS" Binding="{Binding FileSystemType}" Width="180"/>
                            <DataGridTextColumn Header="START LBA" Binding="{Binding StartLba}" Width="110"/>
                            <DataGridTextColumn Header="END LBA" Binding="{Binding EndLba}" Width="120"/>
                            <DataGridTextColumn Header="SIZE" Binding="{Binding DisplaySize}" Width="100"/>
                            <DataGridTextColumn Header="CONFIDENCE" Binding="{Binding Confidence, StringFormat={}{0}%}" Width="90"/>
                            <DataGridTextColumn Header="DETAILS" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 3: FILE SYSTEM ANALYSIS -->
            <TabItem Header="  3. File System Analysis (NTFS / exFAT / FAT32 / ext4)  ">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Independently validates Primary &amp; Backup Volume Boot Records (VBR), cluster geometry, Master File Table ($MFT &amp; $MFTMirr) Record 0 headers, and BitLocker FVE signatures."
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,10"/>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding FileSystems}" AutoGenerateColumns="False" IsReadOnly="True"
                              ColumnHeaderStyle="{StaticResource RecoveryGridHeaderStyle}"
                              Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PART #" Binding="{Binding PartitionIndex}" Width="65"/>
                            <DataGridTextColumn Header="NAME" Binding="{Binding PartitionName}" Width="160"/>
                            <DataGridTextColumn Header="FILE SYSTEM" Binding="{Binding DetectedFileSystem}" Width="105"/>
                            <DataGridTextColumn Header="HEALTH STATUS" Binding="{Binding HealthStatus}" Width="200"/>
                            <DataGridTextColumn Header="PRIMARY VBR" Binding="{Binding PrimaryBootSectorValid}" Width="95"/>
                            <DataGridTextColumn Header="BACKUP VBR" Binding="{Binding BackupBootSectorValid}" Width="95"/>
                            <DataGridTextColumn Header="$MFT REC 0" Binding="{Binding NtfsMftRecord0Valid}" Width="90"/>
                            <DataGridTextColumn Header="$MFTMirr" Binding="{Binding NtfsMftMirrorRecord0Valid}" Width="85"/>
                            <DataGridTextColumn Header="LABEL" Binding="{Binding VolumeLabel}" Width="120"/>
                            <DataGridTextColumn Header="SERIAL / UUID" Binding="{Binding VolumeSerialOrUuid}" Width="140"/>
                            <DataGridTextColumn Header="DIAGNOSTIC EVIDENCE" Binding="{Binding DiagnosticSummary}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 4: METADATA & IMAGING -->
            <TabItem Header="  4. Metadata &amp; Disk Imaging  ">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#FFF8E6" BorderBrush="#E6C36A" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="IMPORTANT: METADATA SNAPSHOT VS. FULL DISK IMAGE" FontSize="10.5" FontWeight="Bold" Foreground="#926800"/>
                            <TextBlock Text="A Metadata Snapshot captures byte-for-byte binary copies of Sector 0 (MBR), Primary &amp; Backup GPT headers/entries, Partition Boot Sectors (VBRs), and initial $MFT headers with SHA-256 verification. It requires only kilobytes of space, whereas a Resumable Disk Image copies the drive sector-by-sector with bad-sector skipping and a .cdemap mapfile."
                                       FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="PART A — BINARY METADATA SNAPSHOT (FAST ROLLBACK BACKUP)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <controls:ResponsiveToolbar>
                                <TextBlock Text="Snapshot Destination Folder:" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <TextBox Text="{Binding SnapshotDirectory, UpdateSourceTrigger=PropertyChanged}" Width="440" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,6"/>
                                <Button Content="Browse..." Style="{StaticResource ActionButtonStyle}" Command="{Binding BrowseSnapshotDirCommand}" Padding="12,6" Margin="0,0,12,6"/>
                                <Button Content="📸 Capture Metadata Snapshot Now" Style="{StaticResource ActionButtonStyle}" Command="{Binding CaptureSnapshotCommand}" Padding="16,6" Margin="0,0,8,6"/>
                                <Button Content="✓ Verify Existing Snapshot" Style="{StaticResource ActionButtonStyle}" Command="{Binding VerifyExistingSnapshotCommand}" Padding="14,6" Margin="0,0,0,6"/>
                            </controls:ResponsiveToolbar>
                            <TextBlock Text="{Binding LastSnapshotSummary}" FontSize="12" Foreground="{StaticResource AccentBlueBrush}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Resumable Disk / Partition Imaging Card -->
                    <Border Grid.Row="2" Background="#F0F6FF" BorderBrush="#B4D2F5" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="PART B — RESUMABLE SECTOR-LEVEL DISK IMAGER (WITH BAD-SECTOR SKIPPING &amp; .CDEMAP TRACKING)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,6"/>
                            <controls:ResponsiveToolbar>
                                <TextBlock Text="Output Image (.img):" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,6"/>
                                <TextBox Text="{Binding ImagingOutputPath, UpdateSourceTrigger=PropertyChanged}" Width="380" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,6"/>
                                <Button Content="Browse..." Style="{StaticResource ActionButtonStyle}" Command="{Binding BrowseImagingOutputCommand}" Padding="12,6" Margin="0,0,12,6"/>
                                <CheckBox Content="Scrape failed blocks (4K sector recovery pass)" IsChecked="{Binding ScrapeFailedBlocks}" VerticalAlignment="Center" Margin="0,0,14,6" FontSize="12"/>
                                <Button Content="▶ Start / Resume Image Job" Style="{StaticResource ActionButtonStyle}" Command="{Binding StartOrResumeImagingCommand}" Padding="14,6" Margin="0,0,8,6"/>
                                <Button Content="⏹ Pause Job" Style="{StaticResource ActionButtonStyle}" Command="{Binding StopImagingCommand}" IsEnabled="{Binding IsImagingRunning}" Padding="12,6" Margin="0,0,0,6"/>
                            </controls:ResponsiveToolbar>
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Grid.Column="0" Value="{Binding ImagingProgressPercent}" Maximum="100" Height="10" VerticalAlignment="Center" Margin="0,0,12,0"
                                             Background="{StaticResource BackgroundLightBrush}" Foreground="{StaticResource AccentBlueBrush}" BorderThickness="0"/>
                                <TextBlock Grid.Column="1" Text="{Binding ImagingStatusSummary}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <DataGrid Grid.Row="3" ItemsSource="{Binding CapturedSnapshotRegions}" AutoGenerateColumns="False" IsReadOnly="True"
                              ColumnHeaderStyle="{StaticResource RecoveryGridHeaderStyle}"
                              Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="REGION ID" Binding="{Binding RegionId}" Width="160"/>
                            <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="280"/>
                            <DataGridTextColumn Header="START LBA" Binding="{Binding StartLba}" Width="100"/>
                            <DataGridTextColumn Header="BYTE OFFSET" Binding="{Binding ByteOffset, StringFormat=0x{0:X}}" Width="120"/>
                            <DataGridTextColumn Header="BYTES" Binding="{Binding ByteLength}" Width="90"/>
                            <DataGridTextColumn Header="BINARY FILE" Binding="{Binding FileName}" Width="210"/>
                            <DataGridTextColumn Header="SHA-256 CHECKSUM" Binding="{Binding Sha256}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- TAB 5: RECOVERY OPTIONS (GUIDED REPAIR ENGINE) -->
            <TabItem Header="  5. Recovery Options (Guided Repair Engine)  ">
                <Grid Margin="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="380"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Candidate Repair Plans List -->
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,12,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="CANDIDATE RECOVERY &amp; REPAIR PLANS" FontSize="10.5" FontWeight="Bold"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,8"/>
                            <ListBox ItemsSource="{Binding ProposedRepairs}" SelectedItem="{Binding SelectedRepairPlan}"
                                     BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding DetectedCondition}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,4"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="Risk: " FontSize="11" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding RiskLevel}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,12,0"/>
                                                    <TextBlock Text="Executable: " FontSize="11" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding IsExecutable}" FontSize="11" FontWeight="Bold"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Right: Selected Plan Evidence, Byte Preview & Execution -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#F0F6FF" BorderBrush="#B4D2F5" BorderThickness="1" CornerRadius="5" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock Text="WHY THIS OPERATION IS OFFERED (EVIDENCE EXPLANATION)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}"/>
                                <TextBlock Text="{Binding SelectedRepairPlan.Title, FallbackValue='No repair plan selected'}" FontSize="15" FontWeight="Bold" Margin="0,4,0,4"/>
                                <TextBlock Text="{Binding SelectedRepairPlan.WhyOfferedExplanation}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding SelectedRepairPlan.RecommendedNextStep}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Exact Byte Range Patches & Hex Preview -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedPlanPatches}" AutoGenerateColumns="False" IsReadOnly="True"
                                  ColumnHeaderStyle="{StaticResource RecoveryGridHeaderStyle}"
                                  Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                                  Margin="0,0,0,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="REGION" Binding="{Binding RegionName}" Width="180"/>
                                <DataGridTextColumn Header="START LBA" Binding="{Binding StartLba}" Width="85"/>
                                <DataGridTextColumn Header="OFFSET" Binding="{Binding TargetByteOffset, StringFormat=0x{0:X}}" Width="105"/>
                                <DataGridTextColumn Header="BYTES" Binding="{Binding ByteLength}" Width="75"/>
                                <DataGridTextColumn Header="BEFORE (HEX PREVIEW)" Binding="{Binding PreviewHexBefore}" Width="210"/>
                                <DataGridTextColumn Header="AFTER (HEX PREVIEW)" Binding="{Binding PreviewHexAfter}" Width="210"/>
                                <DataGridTextColumn Header="CHANGE SUMMARY" Binding="{Binding ChangeSummary}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Execution Controls (Image Repair + Authorized In-Place Physical Disk Repair) -->
                        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Content="🛠  Apply Repair to Disk Image (.img)"
                                        Style="{StaticResource ActionButtonStyle}"
                                        Command="{Binding ApplyRepairToImageCommand}"
                                        IsEnabled="{Binding CanApplySelectedPlanToImage}"
                                        Padding="16,9" VerticalAlignment="Center" Margin="0,0,18,0"/>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RequiredConfirmationPhraseHint}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox Text="{Binding InPlaceConfirmPhrase, UpdateSourceTrigger=PropertyChanged}" Width="220" Height="28" VerticalContentAlignment="Center" Margin="0,2,0,0"
                                                 ToolTip="Type 'REPAIR DISK N' to authorize in-place metadata write when no clone drive is available"/>
                                    </StackPanel>
                                    <Button Content="⚡ Apply In-Place to Physical Disk (With Mandatory Snapshot)"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Command="{Binding ApplyRepairInPlacePhysicalCommand}"
                                            IsEnabled="{Binding CanApplySelectedPlanToPhysicalDisk}"
                                            Padding="14,9" VerticalAlignment="Bottom"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- TAB 6: FILE RECOVERY & EXPORT (NTFS RAW $MFT READER) -->
            <TabItem Header="  6. File Recovery &amp; Export  ">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Top Scan & Filter Bar -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="12" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="READ-ONLY NTFS $MFT FILE BROWSER &amp; EXTRACTOR (WORKS ON UNMOUNTED / RAW VOLUMES)" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,0,0,6"/>
                            <controls:ResponsiveToolbar>
                                <TextBlock Text="Partition:" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                <ComboBox Width="220" Height="28" VerticalContentAlignment="Center" Margin="0,0,10,6"
                                          ItemsSource="{Binding FileSystems}"
                                          SelectedItem="{Binding SelectedRecoveryPartition}"
                                          DisplayMemberPath="PartitionName"/>
                                <CheckBox Content="Include deleted files" IsChecked="{Binding IncludeDeletedFiles}" VerticalAlignment="Center" FontSize="12" Margin="0,0,12,6"/>
                                <Button Content="🔍 Scan $MFT for Recoverable Files" Style="{StaticResource ActionButtonStyle}"
                                        Command="{Binding ScanRecoverableFilesCommand}" Padding="14,6" Margin="0,0,14,6"/>

                                <TextBlock Text="Filter:" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,6"/>
                                <TextBox Text="{Binding FileSearchFilter, UpdateSourceTrigger=PropertyChanged}" Width="180" Height="28" VerticalContentAlignment="Center" Margin="0,0,10,6"
                                         ToolTip="Filter by file name or folder path"/>
                                <Button Content="Select All" Style="{StaticResource ActionButtonStyle}" Command="{Binding SelectAllFilesCommand}" Padding="10,6" Margin="0,0,6,6"/>
                                <Button Content="Clear" Style="{StaticResource ActionButtonStyle}" Command="{Binding ClearSelectedFilesCommand}" Padding="10,6" Margin="0,0,0,6"/>
                            </controls:ResponsiveToolbar>
                            <TextBlock Text="{Binding FileRecoveryStatusText}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBlueBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Recoverable Files Grid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding DisplayedRecoverableFiles}" AutoGenerateColumns="False"
                              ColumnHeaderStyle="{StaticResource RecoveryGridHeaderStyle}"
                              Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrush}"
                              CanUserAddRows="False" Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="EXPORT" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn Header="STATUS" Binding="{Binding StatusLabel}" IsReadOnly="True" Width="170"/>
                            <DataGridTextColumn Header="FILE NAME" Binding="{Binding FileName}" IsReadOnly="True" Width="200"/>
                            <DataGridTextColumn Header="RECONSTRUCTED PATH" Binding="{Binding ReconstructedPath}" IsReadOnly="True" Width="*"/>
                            <DataGridTextColumn Header="SIZE" Binding="{Binding DisplaySize}" IsReadOnly="True" Width="105"/>
                            <DataGridTextColumn Header="MODIFIED (UTC)" Binding="{Binding ModifiedDisplay}" IsReadOnly="True" Width="135"/>
                            <DataGridTextColumn Header="MFT RECORD #" Binding="{Binding MftRecordNumber}" IsReadOnly="True" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Bottom Export Destination Bar -->
                    <Border Grid.Row="2" Background="#F0F6FF" BorderBrush="#B4D2F5" BorderThickness="1" CornerRadius="5" Padding="12">
                        <controls:ResponsiveToolbar>
                            <TextBlock Text="Export Destination Folder (Separate Healthy Drive):" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,6"/>
                            <TextBox Text="{Binding FileExportDestination, UpdateSourceTrigger=PropertyChanged}" Width="420" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,6"/>
                            <Button Content="Browse..." Style="{StaticResource ActionButtonStyle}" Command="{Binding BrowseExportDestCommand}" Padding="12,6" Margin="0,0,14,6"/>
                            <Button Content="📤 Export Checked Files (With SHA-256 Manifest)" Style="{StaticResource ActionButtonStyle}"
                                    Command="{Binding ExportSelectedFilesCommand}" Padding="18,8" Margin="0,0,0,6"/>
                        </controls:ResponsiveToolbar>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 7: SESSION REPORT & AUDIT TRAIL -->
            <TabItem Header="  7. Session Report &amp; Audit Trail  ">
                <Grid Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <controls:ResponsiveToolbar Grid.Row="0" Margin="0,0,0,10">
                        <Button Content="💾 Save JSON &amp; PDF Session Report" Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding ExportReportCommand}" Padding="16,8" Margin="0,0,10,6"/>
                        <Button Content="📄 Open PDF Report" Style="{StaticResource ActionButtonStyle}"
                                Command="{Binding OpenPdfReportCommand}" Padding="16,8" Margin="0,0,0,6"/>
                    </controls:ResponsiveToolbar>

                    <Border Grid.Row="1" Background="{StaticResource LogBgBrush}" CornerRadius="5" Padding="14">
                        <TextBox Text="{Binding AuditLogText, Mode=OneWay}"
                                 FontFamily="Cascadia Code, Consolas, Courier New"
                                 FontSize="12.5" Foreground="{StaticResource LogTextBrush}"
                                 Background="Transparent" BorderThickness="0"
                                 IsReadOnly="True" TextWrapping="Wrap"
                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>

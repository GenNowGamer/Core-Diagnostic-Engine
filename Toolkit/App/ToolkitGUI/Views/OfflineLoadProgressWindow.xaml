<Window x:Class="ToolkitGUI.Views.OfflineLoadProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CDE Offline Load"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="Black">
    <Grid>
        <Image Source="/ToolkitGUI;component/Assets/splash_1920x1080.png"
               Stretch="UniformToFill"
               Opacity="0.92" />

        <Grid VerticalAlignment="Bottom"
              Margin="0,0,0,0"
              Height="160"
              Background="#B30B111A">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="StepText"
                       Grid.Row="0"
                       Margin="28,16,28,8"
                       Foreground="White"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Text="Preparing offline startup..." />

            <TextBlock Grid.Row="1"
                       Margin="28,0,28,14"
                       Foreground="#CCFFFFFF"
                       FontSize="14"
                       Text="Loading offline Windows environment" />

            <Grid Grid.Row="2" Margin="0,0,0,0" VerticalAlignment="Bottom" Height="26">
                <Border Background="#33000000" />
                <ProgressBar x:Name="LoadingProgressBar"
                             Minimum="0"
                             Maximum="100"
                             Value="0"
                             Height="26"
                             BorderThickness="0"
                             Foreground="#31B3FF"
                             Background="#221A2430" />
            </Grid>
        </Grid>
    </Grid>
</Window>

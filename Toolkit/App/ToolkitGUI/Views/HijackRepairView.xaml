<views:WorkflowViewBase x:Class="ToolkitGUI.Views.HijackRepairView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ToolkitGUI.ViewModels"
             xmlns:views="clr-namespace:ToolkitGUI.Views"
             xmlns:controls="clr-namespace:ToolkitGUI.Controls"
             Background="{StaticResource BackgroundDarkBrush}">
    <views:WorkflowViewBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </views:WorkflowViewBase.Resources>
    <views:WorkflowViewBase.DataContext>
        <vm:HijackRepairViewModel/>
    </views:WorkflowViewBase.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BackgroundMidBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <StackPanel>
                <TextBlock Text="🔒  Hijack &amp; Scam Repair" FontSize="22" FontWeight="Bold"/>
                <TextBlock Text="Scan for hijacked browser, network, startup, and security settings. Select repairable items, review details below, or open Quick Repairs for bulk actions."
                           FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource BackgroundMidBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <WrapPanel Grid.Row="0">
                        <Button Content="{Binding ScanButtonLabel}" Command="{Binding ScanCommand}"
                                Style="{StaticResource ActionButtonStyle}" Padding="16,8" Margin="0,0,8,6"/>
                        <Button Content="Repair Selected" Command="{Binding RepairSelectedCommand}"
                                Style="{StaticResource ActionButtonStyle}" Padding="16,8" Margin="0,0,8,6"/>
                        <Button Content="Open Report" Command="{Binding OpenReportCommand}"
                                IsEnabled="{Binding HasScanResults}"
                                Padding="12,8" Margin="0,0,8,6"/>
                        <Button Content="Startup Manager" Command="{Binding OpenStartupManagerCommand}"
                                Padding="12,8" Margin="0,0,8,6"
                                ToolTip="Open Startup Manager filtered to hijack-suspicious entries"/>
                        <Button Content="Select repairable" Command="{Binding SelectRepairableCommand}"
                                Padding="12,8" Margin="0,0,8,6"
                                ToolTip="Check all flagged items that can be repaired here"/>
                        <Button Content="Clear selection" Command="{Binding ClearSelectionCommand}"
                                Padding="12,8" Margin="0,0,8,6"/>
                        <CheckBox Content="Flagged only" IsChecked="{Binding ShowFlaggedOnly}"
                                  VerticalAlignment="Center" Margin="0,0,8,6"/>
                    </WrapPanel>
                    <TextBlock Grid.Row="1" Text="{Binding ScanSummary}" TextWrapping="Wrap"
                               HorizontalAlignment="Stretch">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="FontWeight" Value="Normal"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="FontSize" Value="13"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentBlueBrush}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <controls:VerticalDockPaneHost Grid.Row="1"
                                           PrimaryTitle="Findings"
                                           SecondaryTitle="Finding Details">
                <controls:VerticalDockPaneHost.PrimaryPane>
                    <Grid MinHeight="120">
                        <DataGrid ItemsSource="{Binding DisplayedFindings}"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  SelectedItem="{Binding SelectedFinding, Mode=TwoWay}"
                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="White" BorderThickness="0"
                                  RowHeaderWidth="0" SelectionMode="Single"
                                  IsReadOnly="False" Margin="0">
                            <DataGrid.ColumnHeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource BackgroundMidBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                </Style>
                            </DataGrid.ColumnHeaderStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="FIX" Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      IsEnabled="{Binding Repairable}"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ACTION" Binding="{Binding ActionLabel}" Width="110" IsReadOnly="True"/>
                                <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="82" IsReadOnly="True"/>
                                <DataGridTextColumn Header="RISK" Binding="{Binding Severity}" Width="82" IsReadOnly="True"/>
                                <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="*" IsReadOnly="True">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip" Value="{Binding ToolTipText}"/>
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Background="#80FFFFFF"
                                Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="Scanning..." FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource AccentBlueBrush}"
                                           HorizontalAlignment="Center"/>
                                <ProgressBar IsIndeterminate="True" Width="200" Height="6" Margin="0,12,0,0"
                                             Foreground="{StaticResource AccentBlueBrush}" BorderThickness="0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </controls:VerticalDockPaneHost.PrimaryPane>
                <controls:VerticalDockPaneHost.SecondaryPane>
                    <Border Background="{StaticResource BackgroundMidBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <TextBlock Text="{Binding DetailStatusText}" FontWeight="SemiBold" DockPanel.Dock="Left"
                                           VerticalAlignment="Center"/>
                                <WrapPanel HorizontalAlignment="Right">
                                    <Button Content="Repair this item" Command="{Binding RepairThisItemCommand}"
                                            Style="{StaticResource ActionButtonStyle}" Padding="10,6" Margin="4,0,0,0"/>
                                    <Button Content="Manage" Command="{Binding ManageStartupCommand}"
                                            CommandParameter="{Binding SelectedFinding}"
                                            Style="{StaticResource ActionButtonStyle}" Padding="10,6" Margin="4,0,0,0"
                                            Visibility="{Binding SelectedFinding.CanManageInStartup, Converter={StaticResource BoolToVis}}"/>
                                    <CheckBox Content="Show scan log" IsChecked="{Binding ShowScanLog}"
                                              VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </WrapPanel>
                            </DockPanel>
                            <Grid Grid.Row="1">
                                <TextBlock Text="No finding selected." FontStyle="Italic"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Top">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedFinding}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding SelectedFinding}">
                                    <ScrollViewer.Style>
                                        <Style TargetType="ScrollViewer">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ScrollViewer.Style>
                                    <StackPanel>
                                        <UniformGrid Columns="2" Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Category, StringFormat='Category: {0}'}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding Severity, StringFormat='Risk: {0}'}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding ActionLabel, StringFormat='Action: {0}'}" Margin="0,0,0,4"/>
                                            <TextBlock Text="{Binding RepairableDisplay, StringFormat='Repairable: {0}'}" Margin="0,0,0,4"/>
                                        </UniformGrid>
                                        <TextBlock Text="Name" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                        <TextBlock Text="Location" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding Location}" TextWrapping="Wrap" Margin="0,0,0,10"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Background="{StaticResource BackgroundLightBrush}" Padding="8,6"/>
                                        <TextBlock Text="Current value" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding CurrentValue}" TextWrapping="Wrap" Margin="0,0,0,10"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Background="{StaticResource BackgroundLightBrush}" Padding="8,6"/>
                                        <TextBlock Text="Repair action" FontWeight="Bold" Margin="0,0,0,4"
                                                   Visibility="{Binding CanRepairThis, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding RepairActionDescription}" TextWrapping="Wrap" Margin="0,0,0,10"
                                                   Visibility="{Binding CanRepairThis, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="Guidance" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding GuidanceDisplay}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Border>
                </controls:VerticalDockPaneHost.SecondaryPane>
            </controls:VerticalDockPaneHost>

            <Grid Grid.Row="2" Background="{StaticResource LogBgBrush}"
                  Visibility="{Binding ShowScanLog, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*" MinHeight="80" MaxHeight="200"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{StaticResource BackgroundMidBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1" Padding="16,8">
                    <TextBlock Text="SCAN LOG" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Border>
                <TextBox Grid.Row="1" Text="{Binding LogText, Mode=OneWay}"
                         FontFamily="Cascadia Code, Consolas, Courier New"
                         FontSize="12" Foreground="{StaticResource LogTextBrush}"
                         Background="Transparent" BorderThickness="0"
                         IsReadOnly="True" TextWrapping="Wrap"
                         AcceptsReturn="True" Padding="16,8"
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>

            <!-- Quick Repairs drawer (expands upward from bottom) -->
            <Expander Grid.Row="3"
                      ExpandDirection="Up"
                      IsExpanded="{Binding ShowQuickRepairs}"
                      Background="{StaticResource BackgroundMidBrush}"
                      BorderBrush="{StaticResource BorderBrush}"
                      BorderThickness="0,1,0,0"
                      Padding="0">
                <Expander.Header>
                    <DockPanel Margin="8,6">
                        <TextBlock Text="&#x25B2;" DockPanel.Dock="Right" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                   Margin="8,0,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="&#x25B2;"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowQuickRepairs}" Value="True">
                                            <Setter Property="Text" Value="&#x25BC;"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel>
                            <TextBlock Text="Quick Repairs" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="Bulk browser, network, and security repairs (elevation may be required)"
                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </Expander.Header>
                <Border Background="{StaticResource BackgroundDarkBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="260">
                        <ItemsControl ItemsSource="{Binding Tools}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="2"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="White"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="5"
                                            Padding="12,10" Margin="0,0,8,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" Margin="0,3,0,0"/>
                                                <TextBlock Text="{Binding StatusText}" FontSize="10"
                                                           Foreground="{StaticResource AccentBlueBrush}"
                                                           FontStyle="Italic" Margin="0,4,0,0"/>
                                            </StackPanel>
                                            <Button Grid.Column="1" Content="Run"
                                                    Command="{Binding RunCommand}"
                                                    Style="{StaticResource ActionButtonStyle}"
                                                    Padding="12,6" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Expander>
        </Grid>
    </Grid>
</views:WorkflowViewBase>

<views:WorkflowViewBase x:Class="ToolkitGUI.Views.ChuResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ToolkitGUI.ViewModels"
             xmlns:views="clr-namespace:ToolkitGUI.Views"
             xmlns:controls="clr-namespace:ToolkitGUI.Controls"
             Background="{StaticResource BackgroundDarkBrush}">
    <views:WorkflowViewBase.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </views:WorkflowViewBase.Resources>
    <views:WorkflowViewBase.DataContext>
        <vm:ChuResultsViewModel/>
    </views:WorkflowViewBase.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{StaticResource BackgroundMidBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="💾  CHU Pre-Boot Results" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Core Hardware Utility results written to CDEDATA during last boot diagnostic."
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Content="↻  Refresh" Style="{StaticResource ActionButtonStyle}"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Click="RefreshBtn_Click" Padding="20,10"/>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="1" Background="{StaticResource BackgroundMidBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <StackPanel>
                <controls:ResponsiveToolbar>
                    <TextBlock Text="STATUS" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" Margin="0,0,16,6"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBlueBrush}"
                               VerticalAlignment="Center" Margin="0,0,20,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6"
                                Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                        <Rectangle Width="1" Height="20" Fill="{StaticResource BorderBrush}" Margin="0,0,20,0"/>
                        <TextBlock FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap">
                            <Run Text="Run:  " FontWeight="Bold"/>
                            <Run Text="{Binding RunLabel}"/>
                            <Run Text="     " />
                            <Run Text="Timestamp:  " FontWeight="Bold"/>
                            <Run Text="{Binding Timestamp}"/>
                        </TextBlock>
                    </StackPanel>
                </controls:ResponsiveToolbar>
                <TextBlock Text="{Binding RollupText}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBlueBrush}" Margin="0,8,0,0"
                           Visibility="{Binding HasRollup, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- Content area -->
        <Grid Grid.Row="2">

            <!-- No data message -->
            <Border Background="{StaticResource LogBgBrush}" Padding="40"
                    Visibility="{Binding NoData, Converter={StaticResource BoolToVis}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="⚠" FontSize="48" HorizontalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>
                    <TextBlock Text="{Binding NoDataMessage}" FontSize="14" TextAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Results grid -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}"
                          Padding="24">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,12"
                                    Background="{StaticResource BackgroundMidBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="18,14">
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCategoryHeader}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource BackgroundDarkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Grid.ColumnSpan="4"
                                               Text="{Binding TestName}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Visibility="{Binding IsCategoryHeader, Converter={StaticResource BoolToVis}}"/>

                                    <TextBlock Grid.Column="0" Text="{Binding TestName}"
                                               FontSize="14" FontWeight="SemiBold"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCategoryHeader}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Border Grid.Column="1" CornerRadius="4" Padding="10,4"
                                            Background="{Binding StatusColor}" Margin="8,0,0,0"
                                            HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCategoryHeader}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontSize="12" FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                VerticalAlignment="Center" Margin="8,0,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCategoryHeader}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <TextBlock Text="Errors: " FontSize="12"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Errors}" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>

                                    <TextBlock Grid.Column="3" Text="{Binding Details}"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="16,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCategoryHeader}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <Button Grid.Column="4" Content="Diag &amp; Repair"
                                            Tag="{Binding HighlightContext}"
                                            Click="OpenDiagRepair_Click"
                                            Padding="10,4" Height="28" Margin="8,0,0,0"
                                            Style="{StaticResource ActionButtonStyle}"
                                            Visibility="{Binding ShowDiagRepairLink, Converter={StaticResource BoolToVis}}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Grid>
    </Grid>
</views:WorkflowViewBase>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>ToolkitGUI.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ToolkitGUI\ToolkitGUI.csproj" />
  </ItemGroup>

  <!-- WinExe project references often omit ToolkitGUI.dll from the test output; copy it explicitly. -->
  <Target Name="CopyToolkitGuiAssembly" AfterTargets="Build">
    <PropertyGroup>
      <_ToolkitGuiDll>$(MSBuildThisFileDirectory)..\ToolkitGUI\bin\$(Configuration)\net8.0-windows\ToolkitGUI.dll</_ToolkitGuiDll>
    </PropertyGroup>
    <Copy SourceFiles="$(_ToolkitGuiDll)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true"
          Condition="Exists('$(_ToolkitGuiDll)')" />
  </Target>
</Project>
